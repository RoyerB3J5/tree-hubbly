---
// src/components/BookingWidget.astro
export interface Props {
  widgetId?: string;
  minHeight?: string;
  lockDurationSeconds?: number;
}

const {
  widgetId = "rmSiScvpkyHytIZn7X06",
  minHeight = "500px", // ajusta según el alto real de tu widget
  lockDurationSeconds = 0,
} = Astro.props;
---

<div
  class:list={[
    "booking-widget-wrapper h-[70%]",
    lockDurationSeconds > 0 && "is-locked",
  ]}
  style={`min-height: ${minHeight};`}
  data-widget-src={`https://link.inkshapecrm.com/widget/booking/${widgetId}`}
  data-widget-id={widgetId}
  data-lock-duration={lockDurationSeconds}
  aria-disabled={lockDurationSeconds > 0 ? "true" : undefined}
>
  <!-- Placeholder visible mientras el proveedor carga el calendario -->
  <div class="booking-skeleton" role="status" aria-live="polite">
    <span>Cargando calendario de reservas…</span>
    <a
      class="booking-widget-fallback"
      href={`https://link.inkshapecrm.com/widget/booking/${widgetId}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Si tarda en aparecer, abre el calendario en otra pestaña
    </a>
  </div>
  {
    lockDurationSeconds > 0 && (
      <div
        class="booking-widget-lock"
        role="group"
        aria-label="Calendario bloqueado temporalmente"
      >
        <p>Primero, mira el video</p>
        <p>
          El calendario se habilita en
          <strong>
            <span data-lock-countdown>{lockDurationSeconds}</span> segundos
          </strong>
        </p>
      </div>
    )
  }
</div>

<style>
  .booking-widget-wrapper {
    width: 100%;
    position: relative;
  }

  .booking-widget-wrapper iframe {
    width: 100%;
    border: none;
    overflow: hidden;
    display: block;
  }

  .booking-skeleton {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px;
    border: 1px solid rgb(255 255 255 / 12%);
    background:
      radial-gradient(circle at 50% 0%, rgb(188 154 78 / 12%), transparent 55%),
      linear-gradient(135deg, #07130b 0%, #0d2415 100%);
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
    color: rgb(255 255 255 / 82%);
    font-size: 0.9rem;
    border-radius: 8px;
  }

  .booking-skeleton::before {
    width: 28px;
    height: 28px;
    border: 2px solid rgb(255 255 255 / 25%);
    border-top-color: #bd9a4e;
    border-radius: 50%;
    content: "";
    animation: spin 0.8s linear infinite;
  }

  .booking-widget-fallback {
    display: none;
    color: #d9bd78;
    font-size: 0.8rem;
    text-align: center;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .booking-widget-wrapper.is-slow .booking-widget-fallback {
    display: inline-flex;
  }

  @keyframes shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .booking-widget-wrapper.is-loaded .booking-skeleton {
    display: none;
  }

  .booking-widget-lock {
    position: absolute;
    z-index: 20;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 24px;
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 8px;
    background: rgb(94 101 95 / 70%);
    backdrop-filter: grayscale(1) blur(2px);
    color: #fff;
    font-size: 1rem;
    font-weight: 500;
    text-align: center;
  }

  .booking-widget-lock p {
    margin: 0;
  }

  .booking-widget-lock strong {
    display: block;
    margin-top: 4px;
    color: #f1d58c;
    font-size: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .booking-skeleton,
    .booking-skeleton::before {
      animation: none;
    }
  }
</style>

<script>
  import {
    appendAttributionToUrl,
    captureAttribution,
  } from "../utils/attribution";

  // Se ejecuta una sola vez en el cliente, después de la hidratación de Astro
  function initBookingWidgets() {
    const wrappers = document.querySelectorAll<HTMLElement>(
      ".booking-widget-wrapper:not([data-initialized])",
    );

    if (wrappers.length === 0) return;

    const bookingOrigin = "https://link.inkshapecrm.com";
    if (
      !document.querySelector(`link[rel="preconnect"][href="${bookingOrigin}"]`)
    ) {
      const preconnect = document.createElement("link");
      preconnect.rel = "preconnect";
      preconnect.href = bookingOrigin;
      preconnect.crossOrigin = "anonymous";
      document.head.appendChild(preconnect);
    }

    // Cargamos el script del CRM UNA sola vez, sin importar cuántos widgets haya
    const ensureFormEmbedScript = () => {
      if (document.querySelector('script[src*="form_embed.js"]')) return;
      const s = document.createElement("script");
      s.src = "https://link.inkshapecrm.com/js/form_embed.js";
      s.async = true;
      document.body.appendChild(s);
    };

    const startInteractionLock = (wrapper: HTMLElement) => {
      const durationSeconds = Number(wrapper.dataset.lockDuration);
      if (
        !Number.isFinite(durationSeconds) ||
        durationSeconds <= 0 ||
        wrapper.dataset.lockStarted === "true"
      ) {
        return;
      }

      wrapper.dataset.lockStarted = "true";
      const countdown = wrapper.querySelector<HTMLElement>(
        "[data-lock-countdown]",
      );
      const unlockAt = Date.now() + durationSeconds * 1000;

      const updateLock = () => {
        const secondsLeft = Math.max(
          0,
          Math.ceil((unlockAt - Date.now()) / 1000),
        );
        if (countdown) countdown.textContent = String(secondsLeft);

        if (secondsLeft === 0) {
          wrapper.classList.remove("is-locked");
          wrapper.setAttribute("aria-disabled", "false");
          const iframe = wrapper.querySelector<HTMLIFrameElement>("iframe");
          if (iframe) {
            iframe.inert = false;
            iframe.removeAttribute("tabindex");
          }
          wrapper.querySelector(".booking-widget-lock")?.remove();
          return;
        }

        window.setTimeout(updateLock, 1000);
      };

      updateLock();
    };

    const loadIframe = (wrapper: HTMLElement) => {
      if (wrapper.dataset.initialized === "true") return;
      wrapper.dataset.initialized = "true";

      const baseSrc = wrapper.dataset.widgetSrc!;
      const src = appendAttributionToUrl(
        baseSrc,
        captureAttribution(window),
      );
      const id = wrapper.dataset.widgetId!;
      const fallback = wrapper.querySelector<HTMLAnchorElement>(
        ".booking-widget-fallback",
      );
      if (fallback) fallback.href = src;

      const iframe = document.createElement("iframe");
      iframe.src = src;
      iframe.title = "Calendario para reservar una cita";
      iframe.setAttribute("allow", "payment");
      iframe.setAttribute("scrolling", "no");
      iframe.id = `${id}_${Date.now()}`;
      iframe.style.width = "100%";
      iframe.style.border = "none";
      iframe.style.overflow = "hidden";
      // IntersectionObserver ya controla cuándo inicia; evita una segunda espera.
      iframe.loading = "eager";
      if (wrapper.classList.contains("is-locked")) {
        iframe.inert = true;
        iframe.tabIndex = -1;
      }

      const fallbackTimer = window.setTimeout(() => {
        wrapper.classList.add("is-slow");
      }, 8000);

      iframe.addEventListener(
        "load",
        () => {
          window.clearTimeout(fallbackTimer);
          wrapper.classList.remove("is-slow");
          wrapper.classList.add("is-loaded");
        },
        { once: true },
      );

      wrapper.appendChild(iframe);
      ensureFormEmbedScript();
    };

    // Lazy load real: solo cargamos el iframe cuando está por entrar en pantalla
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadIframe(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "300px" }, // empieza a cargar un poco antes de que sea visible
    );

    wrappers.forEach((wrapper) => {
      startInteractionLock(wrapper);
      observer.observe(wrapper);
    });
  }

  // Astro con view transitions dispara este evento en cada navegación
  document.addEventListener("astro:page-load", initBookingWidgets);
  initBookingWidgets();
</script>
