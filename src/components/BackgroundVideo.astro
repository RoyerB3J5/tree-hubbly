---
import { FiVolume2, FiVolumeX } from "react-icons/fi";

interface Props {
  src: string;
  desktopSrc?: string;
  poster?: string;
  class?: string;
  eager?: boolean;
  sound?: boolean;
}

const { src, desktopSrc, poster, class: videoClass, eager = false, sound = true } = Astro.props;
const desktopMedia = "(min-width: 728px)";
const english = Astro.params.lang === "en";
const enableSound = english ? "Enable sound" : "Activar sonido";
const muteSound = english ? "Mute sound" : "Silenciar";
---
<background-video data-src={src} data-desktop-src={desktopSrc} data-desktop-media={desktopSrc ? desktopMedia : undefined}>
  <video
    class={videoClass}
    src={eager && !desktopSrc ? src : undefined}
    poster={poster}
    autoplay={eager}
    muted
    playsinline
    loop
    preload={eager ? "auto" : "none"}
    aria-hidden="true"
    tabindex="-1"
  >
    {eager && desktopSrc && (
      <>
        <source src={desktopSrc} type="video/mp4" media={desktopMedia} />
        <slot name="mobile-source" />
        <source src={src} type="video/mp4" />
      </>
    )}
  </video>
  {eager && poster && (
    <img class={videoClass} src={poster} alt="" fetchpriority="high" data-video-poster hidden />
  )}
  {sound && (
    <button type="button" aria-label={enableSound} data-enable={enableSound} data-mute={muteSound} data-muted hidden>
      <span data-sound-off aria-hidden="true"><FiVolumeX size={20} /></span>
      <span data-sound-on aria-hidden="true"><FiVolume2 size={20} /></span>
    </button>
  )}
</background-video>

<style>
  background-video { display: contents; }

  video { pointer-events: none; }
  video::-webkit-media-controls-start-playback-button { display: none !important; }
  video::-webkit-media-controls-overlay-play-button { display: none !important; }

  button {
    position: absolute;
    top: .75rem;
    right: .75rem;
    z-index: 15;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / .55);
    border-radius: .5rem;
    background: rgb(5 23 37 / .9);
    color: white;
    cursor: pointer;
  }
  button:not([hidden]) {
    display: grid;
    place-items: center;
  }
  button[data-muted] [data-sound-on],
  button:not([data-muted]) [data-sound-off] {
    display: none;
  }
  button:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }
</style>

<script>
  let audibleVideo: HTMLVideoElement | undefined;

  class BackgroundVideo extends HTMLElement {
    #cleanup?: () => void;

    connectedCallback() {
      const video = this.querySelector("video");
      const button = this.querySelector("button");
      const poster = this.querySelector<HTMLImageElement>("[data-video-poster]");
      const src = this.dataset.src;
      const { desktopSrc, desktopMedia } = this.dataset;
      if (this.#cleanup || !video || !src) return;

      const events = new AbortController();
      const { signal } = events;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const viewport = this.closest<HTMLElement>("[data-video-viewport]") ?? video;
      const cover = viewport.hasAttribute("data-sticky-video") ? viewport.nextElementSibling : null;
      const bounds = viewport.getBoundingClientRect();
      let visible = bounds.bottom > 0 && bounds.top < window.innerHeight;
      let covered = false;
      let autoplayDenied = false;
      let retries = 0;
      let retryTimer: ReturnType<typeof setTimeout>;
      let resumeTimer: ReturnType<typeof setTimeout>;

      const eager = video.autoplay;
      const hasSources = Boolean(video.querySelector("source"));
      video.defaultMuted = true;
      video.muted = true;
      if (reducedMotion.matches) video.autoplay = false;
      if (poster) poster.hidden = !video.paused && video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA;

      const mute = () => {
        video.muted = true;
        if (audibleVideo === video) audibleVideo = undefined;
      };

      const updateButton = () => {
        if (!button) return;
        button.toggleAttribute("data-muted", video.muted);
        button.setAttribute("aria-label", (video.muted ? button.dataset.enable : button.dataset.mute) ?? "");
        button.hidden = Boolean(video.error) || !(
          video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA || reducedMotion.matches || autoplayDenied
        );
      };

      const play = () => {
        if (video.error) return;
        if (!hasSources && !video.hasAttribute("src")) {
          const useDesktop = desktopSrc && desktopMedia && window.matchMedia(desktopMedia).matches;
          video.src = useDesktop ? desktopSrc : src;
        }
        if (video.paused) return video.play();
      };

      const onScreen = () => visible && !covered && !document.hidden;
      const syncPlayback = () => {
        if (!onScreen()) {
          mute();
          video.pause();
        } else if (!reducedMotion.matches || !video.muted) {
          play()?.catch((error: DOMException) => {
            if (error.name !== "NotAllowedError" || signal.aborted) return;
            autoplayDenied = true;
            updateButton();
          });
        } else {
          video.pause();
        }
        updateButton();
      };

      const observer = "IntersectionObserver" in window ? new IntersectionObserver(([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        syncPlayback();
      }) : undefined;
      observer?.observe(viewport);
      if (!observer) visible = true;

      if (cover) {
        const updateCover = () => {
          // A sticky hero can still intersect the viewport under the next section.
          const next = cover.getBoundingClientRect().top <= (covered ? 48 : 0);
          if (next === covered) return;
          covered = next;
          syncPlayback();
        };
        window.addEventListener("scroll", updateCover, { passive: true, signal });
        window.addEventListener("resize", updateCover, { signal });
        updateCover();
      }

      if (button) {
        button.addEventListener("click", () => {
          if (video.error) return;
          if (!video.muted) {
            mute();
            syncPlayback();
          } else {
            if (audibleVideo) audibleVideo.muted = true;
            audibleVideo = video;
            video.muted = false;
            play()?.catch(() => {
              if (signal.aborted || audibleVideo !== video) return;
              mute();
              syncPlayback();
            });
          }
          updateButton();
        }, { signal });
      }

      video.addEventListener("volumechange", updateButton, { signal });
      video.addEventListener("loadeddata", updateButton, { signal });
      video.addEventListener("canplay", syncPlayback, { signal });
      video.addEventListener("playing", () => {
        if (poster) poster.hidden = true;
        clearTimeout(resumeTimer);
        updateButton();
        retries = 0;
      }, { signal });
      video.addEventListener("pause", () => {
        if (!eager || !onScreen() || reducedMotion.matches || video.error) return;
        clearTimeout(resumeTimer);
        resumeTimer = setTimeout(syncPlayback, 250);
      }, { signal });
      video.addEventListener("emptied", updateButton, { signal });
      video.addEventListener("error", () => {
        if (poster) poster.hidden = false;
        updateButton();
        if (!onScreen() || retries >= 3 || video.error?.code !== MediaError.MEDIA_ERR_NETWORK) return;
        const resumeTime = video.currentTime;
        retryTimer = setTimeout(() => {
          if (!onScreen()) return;
          if (resumeTime > 0) video.addEventListener("loadedmetadata", () => {
            if (resumeTime < video.duration) video.currentTime = resumeTime;
          }, { once: true, signal });
          video.load();
          syncPlayback();
        }, 1000 * ++retries);
      }, { signal });

      reducedMotion.addEventListener("change", syncPlayback, { signal });
      document.addEventListener("visibilitychange", syncPlayback, { signal });
      window.addEventListener("pageshow", syncPlayback, { signal });
      if (eager) {
        // Retry inside a real gesture when the browser blocks background autoplay.
        document.addEventListener("click", syncPlayback, { capture: true, signal });
        document.addEventListener("touchend", syncPlayback, { passive: true, signal });
      }
      this.#cleanup = () => {
        events.abort();
        observer?.disconnect();
        clearTimeout(retryTimer);
        clearTimeout(resumeTimer);
        mute();
        video.pause();
        this.#cleanup = undefined;
      };
      syncPlayback();
    }

    disconnectedCallback() {
      this.#cleanup?.();
    }
  }

  if (!customElements.get("background-video")) customElements.define("background-video", BackgroundVideo);
</script>
