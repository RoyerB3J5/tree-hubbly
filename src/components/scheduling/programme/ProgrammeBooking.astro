---
import FormContact from "../../FormContact.astro";
import type { ProgrammeContent } from "../../../content/schedulingProgramme";

interface Props {
  content: ProgrammeContent["booking"];
}

const { content } = Astro.props;
---

<section
  class="w-full flex justify-center items-center"
  id="form"
  aria-labelledby="programme-booking-title"
>
  <div
    class="relative z-10 container-full flex flex-col justify-center items-center h-full py-10 md:py-0 gap-10 md:gap-0"
  >
    <div class="flex flex-col justify-center items-center gap-6">
      <h2
        id="programme-booking-title"
        class="text-[20px] font-semibold leading-[150%] text-center text-[#F7F7F7]"
      >
        <span class="text-secondary">{content.stepLabel}</span> {content.title}
      </h2>
      <p class="text-[#F7F7F7] text-[15px] md:text-[16px] font-normal text-center">
        {content.helpText}{" "}
        <a href={content.whatsappUrl} class="text-secondary underline">
          {content.whatsappLabel}
        </a>{" "})
      </p>
    </div>
    <FormContact />
  </div>
</section>
