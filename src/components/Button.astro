---
interface Props {
  text?: string;
  href?: string;
  target?: string;
  rel?: string;
  baseBtnClass?: string;
  extraBtnClass?: string;
  baseTextClass?: string;
  textClass?: string;
}

const {
  text = '',
  baseBtnClass = 'flex justify-center items-center cursor-pointer z-[10] rounded-[8px] box-border px-8 py-4 border-[1px]',
  extraBtnClass = '',
  baseTextClass = 'font-semibold leading-[150%] text-[16px]',
  textClass = '',
  href,
  target,
  rel,
} = Astro.props as Props;

const normalizedHref =
  typeof href === 'string' && /^\/(tel:|mailto:)/.test(href)
    ? href.replace(/^\/+/, '')
    : href;
const buttonClasses = `action-button ${baseBtnClass} ${extraBtnClass}`.trim();
const paragraphClasses = `${baseTextClass} ${textClass}`.trim();
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href ? normalizedHref : undefined}
  type={href ? undefined : 'button'}
  class={buttonClasses}
  target={href ? target : undefined}
  rel={href ? (rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined)) : undefined}
>
  <span class:list={["button-content", textClass]}>
    <span class="button-arrow-window button-arrow-window--leading hidden md:block" aria-hidden="true">
      <svg class="button-arrow button-arrow--leading" width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M4 12H20M13 19L20 12L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <span class="button-label">{text ? <span class={paragraphClasses}>{text}</span> : <slot />}</span>
    <span class="button-arrow-window button-arrow-window--trailing" aria-hidden="true">
      <svg class="button-arrow button-arrow--trailing" width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M4 12H20M13 19L20 12L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </span>
</Tag>

<style>
  .action-button {
    overflow: hidden;
    transition: background-color 300ms ease, border-color 300ms ease, border-radius 600ms ease-in-out, color 300ms ease;
  }
  .button-content {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding-right: 32px;
  }
  .button-label, .button-arrow {
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1), opacity 350ms ease, color 300ms ease;
  }
  .button-arrow-window {
    position: absolute;
    top: 50%;
    width: 24px;
    height: 24px;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .button-arrow-window--leading { left: 0; }
  .button-arrow-window--trailing { right: 0; }
  .button-arrow { position: absolute; inset: 0; display: block; width: 24px; height: 24px; }
  .button-arrow--leading { transform: translateX(var(--arrow-enter-offset, -48px)); }
  .action-button.bg-secondary .button-arrow { color: var(--color-primary); }
  .action-button.bg-primary .button-arrow { color: var(--color-paragraph); }

  @media (hover: hover) {
    .action-button:hover { border-radius: var(--button-pill-radius, 32px); }
    .action-button.bg-secondary:hover, .action-button.bg-primary:hover {
      background-color: var(--color-paragraph);
      border-color: var(--color-paragraph);
      color: var(--color-primary);
    }
    .action-button.bg-primary:hover .button-content,
    .action-button.bg-primary:hover .button-label :global(*) { color: var(--color-primary); }
    .action-button.bg-primary:hover .button-arrow { color: var(--color-primary); }
    .action-button:hover .button-label { transform: translateX(32px); }
    .action-button:hover .button-arrow--leading { transform: translateX(0); }
    .action-button:hover .button-arrow--trailing { transform: translateX(var(--arrow-exit-offset, 48px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .action-button, .button-label, .button-arrow { transition: none; }
  }
</style>



<script>
  const buttons = document.querySelectorAll<HTMLElement>(".action-button");
  const updateRadius = (button: HTMLElement) => {
    button.style.setProperty("--button-pill-radius", `${button.offsetHeight / 2}px`);
    const bounds = button.getBoundingClientRect();
    const leading = button.querySelector<HTMLElement>(".button-arrow-window--leading")?.getBoundingClientRect();
    const trailing = button.querySelector<HTMLElement>(".button-arrow-window--trailing")?.getBoundingClientRect();
    if (leading && trailing) {
      button.style.setProperty("--arrow-enter-offset", `${bounds.left - leading.right}px`);
      button.style.setProperty("--arrow-exit-offset", `${bounds.right - trailing.left}px`);
    }
  };
  buttons.forEach(updateRadius);
  if ("ResizeObserver" in window) {
    const observer = new ResizeObserver((entries) => {
      entries.forEach((entry) => updateRadius(entry.target as HTMLElement));
    });
    buttons.forEach((button) => observer.observe(button));
  } else {
    window.addEventListener("resize", () => buttons.forEach(updateRadius));
  }
</script>
