---
import {
  emailAddress,
  facebookLink,
  phoneNumber,
  phoneNumberLink,
} from "../constants/info";
import Button from "./Button.astro";
import ChangeLanguage from "./ChangeLanguage.astro";

type Translations = typeof import("../i18n/en-2").default;
type HeaderContent = Translations["header"];
interface Props {
  content?: HeaderContent;
}
const { content } = Astro.props as Props;

// Obtener la ruta actual y normalizar el path sin prefijo de idioma
const currentPath = Astro.url.pathname;
// Normalizar: remover idioma y trailing slash
const normalized =
  currentPath.replace(/^\/(en|es)/, "").replace(/\/$/, "") || "/";
// Detectar el idioma actual ('en' o 'es')
const match = currentPath.match(/^\/(en|es)/);
const lang = match ? match[1] : "en";
---

<header
  class={`fixed left-0 right-0 z-50 w-full flex flex-col justify-center items-center top-0`}
  style="transition: transform 0.3s ease-out, background-color 0.3s ease-out; will-change: transform;"
  id="site-header"
>
  <div
    id="header-main-bar"
    class={`w-full flex justify-center items-center h-18 md:h-20 transition-colors duration-300`}
  >
    <div
      class="max-w-[1280px] px-4 xl:px-0 w-full flex justify-between items-center relative"
    >
      <a
        href={`/${lang}`}
        aria-label="Ir a la página principal"
        title="Philly Steak - Init"
      >
        <img
          src="/images/logo.svg"
          alt="Logo de Tree Hubbly"
          width="240"
          height="127"
          class="cursor-pointer w-[136px] md:w-[164px] h-auto"
        />
      </a>
      <div class="flex justify-center items-center gap-2 md:gap-6">
        <Button
          text={content?.buttons[0].label}
          href={content?.buttons[0].href}
          textClass="text-primary"
          extraBtnClass="header-cta hidden lg:flex bg-secondary border-secondary"
        />
        {/*<ChangeLanguage /> */}
        <button
          type="button"
          aria-label="Abrir menú de navegación"
          title="Abrir menú"
          class="flex items-center justify-center cursor-pointer w-10 md:w-12 h-10 md:h-12 rounded overflow-hidden"
          id="hamburger-btn"
          aria-expanded="false"
          aria-controls="desktop-menu"
        >
          <svg id="menu-open-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M24 4C35.0456 4 44 12.9543 44 24C44 35.0456 35.0456 44 24 44C12.9543 44 4 35.0456 4 24C4 12.9543 12.9543 4 24 4Z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke="#F7F7F7"/>
            <path d="M16 20H32M16 28H32" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke="#F7F7F7"/>
          </svg>
          <img id="menu-close-icon" src="/images/icons/equis-header.svg" alt="" width="48" height="48" class="hidden w-12 h-12" />
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const openBtn = document.getElementById("hamburger-btn");
    const body = document.body;

    const desktopMenu = document.getElementById("desktop-menu");
    const pageContent = document.getElementById("page-content");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");
    let desktopOpen = false;

    function updateMenuScale() {
      if (!pageContent) return;
      const width = document.documentElement.clientWidth;
      pageContent.style.setProperty("--menu-scale", String(Math.min(1, (width - 32) / width, 1280 / width)));
    }

    function setDesktopMenu(open) {
      if (open && pageContent) {
        pageContent.style.setProperty("--menu-origin-y", `${-pageContent.getBoundingClientRect().top}px`);
        updateMenuScale();
      }
      desktopOpen = open;
      body.classList.toggle("desktop-menu-open", open);
      document.documentElement.classList.toggle("desktop-menu-open", open);
      if (desktopMenu) {
        desktopMenu.inert = !open;
        desktopMenu.setAttribute("aria-hidden", String(!open));
      }
      openBtn?.setAttribute("aria-expanded", String(open));
      openBtn?.setAttribute("aria-label", open ? "Cerrar menú de navegación" : "Abrir menú de navegación");
      openBtn?.setAttribute("title", open ? "Cerrar menú" : "Abrir menú");
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    }

    openBtn?.addEventListener("click", () => {
      setDesktopMenu(!desktopOpen);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && desktopOpen) {
        setDesktopMenu(false);
        openBtn?.focus();
      }
    });
    desktopMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setDesktopMenu(false));
    });

    // Header: height var + hide on scroll down / show on scroll up
    const header = document.getElementById("site-header");
    const headerTopBar = document.getElementById("header-top-bar");
    const headerMainBar = document.getElementById("header-main-bar");

    function updateHeaderHeight() {
      const height = headerTopBar?.offsetHeight || 0;
      document.documentElement.style.setProperty(
        "--header-height",
        `${height}px`,
      );
    }
    if (headerTopBar) {
      updateHeaderHeight();
      window.addEventListener("resize", updateHeaderHeight);
    }

    if (!header) return;

    let lastScrollY = window.scrollY || document.documentElement.scrollTop;
    let ticking = false;
    const HIDE_AFTER = 80; // start hiding only after scrolling past this
    const DELTA = 5; // ignore tiny jitter

    const showHeader = () => {
      header.style.transform = "translateY(0)";
    };

    const hideHeader = () => {
      header.style.transform = "translateY(-100%)";
    };

    const isMenuOpen = () => desktopOpen;

    const updateMainBarBg = (currentY) => {
      if (!headerMainBar) return;
      // Solid pages (anything other than /, /menu, /about-us) always stay dark.
      if (headerMainBar.dataset.solid === "true") {
        headerMainBar.classList.add("bg-[#051725]");
        headerMainBar.classList.remove("bg-transparent");
        return;
      }
      // Past the initial viewport (with a small threshold so it triggers reliably)
      const pastViewport = currentY > window.innerHeight - 80;
      headerMainBar.classList.toggle("bg-[#051725]", pastViewport);
      headerMainBar.classList.toggle("bg-transparent", !pastViewport);
    };

    const onScroll = () => {
      const currentY = window.scrollY || document.documentElement.scrollTop;
      const diff = currentY - lastScrollY;

      updateMainBarBg(currentY);

      // Don't hide while mobile menu is open
      if (isMenuOpen()) {
        showHeader();
        lastScrollY = currentY;
        ticking = false;
        return;
      }

      // Always visible at the very top
      if (currentY <= HIDE_AFTER) {
        showHeader();
      } else if (diff > DELTA) {
        // Scrolling down -> hide
        hideHeader();
      } else if (diff < -DELTA) {
        // Scrolling up -> show
        showHeader();
      }

      lastScrollY = currentY;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true },
    );
    window.addEventListener("resize", () => {
      if (desktopOpen) updateMenuScale();
      updateMainBarBg(window.scrollY || document.documentElement.scrollTop);
    });
    onScroll();
  });
</script>
