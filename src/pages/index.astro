---
import SEOHead from "../components/SEOHead.astro";
---
<!doctype html>
<html lang="en">
  <head>
    <SEOHead />
    <!-- Redirección inmediata para Bots/SEO (al idioma por defecto) -->
    <meta http-equiv="refresh" content="0;url=/en/" />


    <!-- Redirección inmediata para usuarios reales -->
    <script is:inline>    
      window.location.href = "/en/";
    </script>
  </head>
  <body style="background-color: #FFF;"> </body>
</html>
