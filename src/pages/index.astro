<script is:inline>
  if (typeof window !== 'undefined') {
    const p = window.location.pathname;
    // Solo redirigir si la ruta es exactamente "/" o cadena vacía
    if (p === '/' || p === '') {
      // Mantiene la landing publicada como única página de entrada.
      const destino =
        '/scheduling/programme/' + window.location.search + window.location.hash;
      window.location.replace(destino);
    }
  }
</script>
