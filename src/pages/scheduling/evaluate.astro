---

import { phoneNumber, phoneNumberLink } from "../../constants/info";
import LayoutScheduling from "../../layouts/LayoutScheduling.astro";


const contentUS = {
  badge: "Your call is confirmed — check your email",
  title:
    'Before we talk, <br /> <span class="text-secondary font-georgia">you need to see this.</span>',
  subtitle: "Directly impacts your business. 8 minutes.",
};

const contentEs = {
  badge: "Built for tree service companies",
  title:
    'Calls Answered. <br/> Leads Followed Up.<br/> Jobs Booked.<br/> None of It by You.',
  subtitle: "Free for 31 Days",
  button:"Book Your Free Setup Call ",
  paragraph:"No credit card · No commitment · No hard sell.",
  videoTitle:"Still deciding? <span class='text-secondary'>See exactly how it works.</span>"
};

const content = contentEs;
const calendarLockDurationSeconds = 60; // Cambiar a 60 al terminar la prueba.
---

<LayoutScheduling mainClass="w-full flex flex-col justify-center items-center relative z-0 back-scheduling gap-10">
    
    <div
      class="container-full flex flex-col justify-center items-center pt-[91px] md:pt-35 gap-6"
    >
      <div class="bg-primary rounded-full py-[7px] px-4 flex justify-center items-center">
        <p class='text-[11.5px] md:text-[13.1px] text-secondary font-extrabold uppercase leading-[100%]'>{content.badge}</p>
      </div>
      
      <h1 class='text-[33.6px] md:text-[57.6px] font-bold leading-[105%] tracking-[-0.336px] md:tracking-[-0.57px] text-white text-center' set:html={content.title}></h1>
      <h2 class="text-[30.4px] md:text-[48px] leading-[105%] tracking-[-0.304px]  md:tracking-[-0.48px] text-secondary font-bold">{content.subtitle}</h2>
      <a
        class="bg-secondary flex items-center justify-center w-[335px] md:px-[48px] py-[21px] md:py-[18px] rounded-[14px] shrink-0 w-full md:w-auto shadow-[0_0_30px_0_#91D200] hover:-translate-y-1 transition-transform duration-300 ease-in-out"
        href="/scheduling/evaluate#form"
      >
        <span
          class="font-extrabold text-[17.6px] md:text-[23.2px] text-[#0a0a0a] leading-[100%] capitalize"
        >
          {content.button}
        </span>
      </a>
      <p class="text-[15px] md:text-[17.6px] leading-[100%] font-medium text-white">{content.paragraph}</p>
    </div>
    <section
      class="w-full flex justify-center items-center"
      id="form"
    >
      <div
        class="relative z-10 container-full flex justify-center items-center h-full py-10 md:py "
      >
        
      </div>
    </section>
    <section class="container-full flex flex-col justify-center items-center gap-10 pb-2">
      <p set:html={content.videoTitle} class='text-[20.8px] md:text-[28.8px] font-extrabold leading-[100%] text-white text-center'></p>
      <div class='w-full md:w-[60%] h-auto aspect-video bg-white rounded-2xl'></div>
    </section>
    <div class='container-full flex justify-between items-center py-6'>
    <a href="/" class="cursor-pointer">
        <img
          src="/images/logo.svg"
          alt="logo de Treehubly"
          width="190"
          height="40"
          class="w-[154px] h-auto"
          decoding="async"
          loading="eager"
        />
      </a>
      <p class='text-[13.6px] text-white font-normal leading-[100%]'>© 2026 Treehubly · Privacy</p>
    </div>
  
</LayoutScheduling>
