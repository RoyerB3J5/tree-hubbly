---
import en from '../../i18n/en-2';
import es from '../../i18n/es-2';
import Layout from '../../layouts/Layout.astro';
import Questions from '../../sections/main/Questions.astro';
import Scale from '../../sections/main/Scale.astro';
import type { Language } from '../../types/language.type';

import HeroMain from '../../sections/main/HeroMain.astro';
import Book from '../../sections/main/Book.astro';
import Faltantes from '../../sections/main/Faltantes.astro';
import Steps from '../../sections/main/Steps.astro';
import Reasons from '../../sections/main/Reasons.astro';
import Numbers from '../../sections/main/Numbers.astro';
import Control from '../../sections/main/Control.astro';
import Path from '../../sections/main/Path.astro';
import Guide from '../../sections/main/Guide.astro';
export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

export const defaultRedirect = '/en';

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
---
<Layout lang={lang} t={t}>
  {/*
  <Path content={t.main.path} />
  <Traditional2 content={t.main.traditional} client:load/>
  <BannerImages content={t.main.bannerImage} />
  <CallAction content={t.main.call} />
  */}
  <HeroMain content={t.main.hero} />
  <Faltantes content={t.main.system} />
  <section class="w-full bg-[#F7F7F7] py-10 md:py-20  flex justify-center items-center" id="book">
    <Book content={t.main.session} />
  </section>
  <Scale content={t.main.grow} />
  <Steps content={t.main.steps} />
  <Reasons content={t.main.reasons} />
  <Numbers content={t.main.numbers} />
  <Control content={t.main.control} />
  <Path content={t.main.path} />
  <Guide content={t.main.guide} />
  <Questions content={t.main.ask} /> 
</Layout>