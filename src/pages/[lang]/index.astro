---
import en from '../../i18n/en-2';
import es from '../../i18n/es-2';
import Layout from '../../layouts/Layout.astro';
import Questions from '../../sections/main/Questions.astro';
import Scale from '../../sections/main/Scale.astro';
import type { Language } from '../../types/language.type';

import HeroMain from '../../sections/main/HeroMain.astro';
import Book from '../../sections/main/Book.astro';
import Faltantes from '../../sections/main/Faltantes.astro';
import Steps from '../../sections/main/Steps.astro';
import Reasons from '../../sections/main/Reasons.astro';
import Numbers from '../../sections/main/Numbers.astro';
import Control from '../../sections/main/Control.astro';
import Path from '../../sections/main/Path.astro';
import Guide from '../../sections/main/Guide.astro';
import Prices from '../../sections/main/Prices.astro';
import Marketing from '../../sections/main/Marketing.astro';
import CallAction from '../../sections/main/CallAction.astro';
export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

export const defaultRedirect = '/en';

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
---
<Layout lang={lang} t={t} pageClass="home-page-sections">
  <HeroMain content={t.main.hero}/>
  <Faltantes content={t.main.system} />
  <section class="w-full bg-[#F7F7F7] py-10 md:py-20  flex justify-center items-center" id="book">
    <Book content={t.main.session} />
  </section>
  <Scale content={t.main.grow} />
  <Steps content={t.main.steps} />
  <Reasons content={t.main.reasons} />
  <Numbers content={t.main.numbers} />
  <Control content={t.main.control} />
  <Path content={t.main.path} />
  <Prices content={t.main.ecosystem} />
  <Guide content={t.main.guide} />
  <Marketing content={t.main.marketing} />
  <CallAction content={t.main.business} />
  <Questions content={t.main.ask} /> 
</Layout>

<script>
  import { gsap, ScrollTrigger } from "../../scripts/gsap";

  const hero = document.querySelector<HTMLElement>(".home-page-sections > .hero-main");
  const nextSection = document.querySelector<HTMLElement>(".home-page-sections > #faltantes");
  const bookSection = document.querySelector<HTMLElement>(".home-page-sections > #book");
  const scaleSection = document.querySelector<HTMLElement>(".home-page-sections > .home-scale");
  const stepsSection = document.querySelector<HTMLElement>(".home-page-sections > .home-steps");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Reserve the line reveals for the card sequence only when the section fits.
  const canPinSteps = () => Boolean(stepsSection && window.innerWidth >= 1024 &&
    !reduceMotion.matches && stepsSection.offsetHeight <= window.innerHeight);
  if (canPinSteps()) stepsSection?.classList.add("steps-scroll-controlled");

  document.addEventListener("DOMContentLoaded", () => {
    if (!stepsSection?.classList.contains("steps-scroll-controlled")) return;
    const cards = gsap.utils.toArray<HTMLElement>(stepsSection.querySelectorAll(".steps-card"));
    if (!cards.length) return;

    const media = gsap.matchMedia();
    media.add("(min-width: 1024px) and (prefers-reduced-motion: no-preference)", () => {
      if (!canPinSteps()) {
        stepsSection.classList.remove("steps-scroll-controlled");
        stepsSection.querySelectorAll(".steps-card .fade-up-lines-raw").forEach((text) => text.classList.add("active"));
        return;
      }

      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: stepsSection,
          start: "top top",
          end: () => `+=${window.innerHeight * cards.length * 0.6}`,
          pin: true,
          pinSpacing: true,
          scrub: true,
          invalidateOnRefresh: true,
          anticipatePin: 1,
        },
      });

      cards.forEach((card, index) => {
        const background = card.querySelector(".steps-card-background");
        const content = card.querySelectorAll(".steps-card-content");
        const text = card.querySelectorAll<HTMLElement>("h1.fade-up-lines-raw, h2.fade-up-lines-raw, h3.fade-up-lines-raw, h4.fade-up-lines-raw, h5.fade-up-lines-raw, h6.fade-up-lines-raw, p.fade-up-lines-raw");
        text.forEach((element, textIndex) => {
          element.classList.remove("active");
          element.style.setProperty("--fade-up-lines-delay", `${textIndex * 0.18}s`);
        });
        gsap.set(background, { scaleY: 0, transformOrigin: "center bottom" });
        gsap.set(content, { autoAlpha: 0 });
        timeline.to(background, { scaleY: 1, duration: 0.45, ease: "power2.out" }, index)
          .set(content, { autoAlpha: 1 }, index + 0.45)
          .call(() => text.forEach((element) => element.classList.add("active")), [], index + 0.45)
          .to({}, { duration: 0.55 }, index + 0.45);
      });

      let lockedUntil = 0;
      const onWheel = (event: WheelEvent) => {
        const trigger = timeline.scrollTrigger;
        if (!trigger || event.ctrlKey || document.documentElement.classList.contains("desktop-menu-open") ||
            document.getElementById("mobile-menu")?.classList.contains("translate-x-0")) return;
        const now = performance.now();
        if (now < lockedUntil) { event.preventDefault(); return; }
        if (!trigger.isActive || Math.abs(event.deltaY) < 2) return;
        if ((event.deltaY < 0 && trigger.progress <= 0.001) ||
            (event.deltaY > 0 && trigger.progress >= 0.999)) return;
        const current = Math.round(trigger.progress * cards.length);
        const step = gsap.utils.clamp(0, cards.length, current + (event.deltaY > 0 ? 1 : -1));
        event.preventDefault();
        lockedUntil = now + 900;
        window.scrollTo({ top: trigger.start + (trigger.end - trigger.start) * step / cards.length, behavior: "smooth" });
      };
      window.addEventListener("wheel", onWheel, { passive: false, capture: true });
      ScrollTrigger.refresh();
      return () => {
        window.removeEventListener("wheel", onWheel, true);
        stepsSection.classList.remove("steps-scroll-controlled");
        stepsSection.querySelectorAll(".steps-card .fade-up-lines-raw").forEach((text) => text.classList.add("active"));
      };
    });
  });

  if (hero && nextSection) {
    let snapping = false;
    let unlockTimer: ReturnType<typeof setTimeout>;
    let touchStart: { y: number; destination: HTMLElement } | null = null;

    const menuIsOpen = () => document.documentElement.classList.contains("desktop-menu-open") ||
      document.getElementById("mobile-menu")?.classList.contains("translate-x-0");
    const getDestination = (): HTMLElement | null => {
      const faltantesTop = nextSection.getBoundingClientRect().top + window.scrollY;
      if (window.scrollY < faltantesTop - 8) return nextSection;
      const pairs = [[nextSection, bookSection], [scaleSection, stepsSection]] as const;
      for (const [current, destination] of pairs) {
        if (!current || !destination) continue;
        const currentTop = current.getBoundingClientRect().top + window.scrollY;
        const destinationTop = destination.getBoundingClientRect().top + window.scrollY;
        const nearEnd = Math.max(currentTop, destinationTop - window.innerHeight);
        if (window.scrollY >= nearEnd - 8 && window.scrollY < destinationTop - 8) return destination;
      }
      return null;
    };
    const goToNextSection = (destination: HTMLElement) => {
      snapping = true;
      destination.scrollIntoView({ behavior: "smooth", block: "start" });
      clearTimeout(unlockTimer);
      unlockTimer = setTimeout(() => { snapping = false; }, 1100);
    };

    window.addEventListener("wheel", (event) => {
      if (reduceMotion.matches || menuIsOpen() || event.ctrlKey) return;
      if (snapping) {
        if (event.deltaY > 0) event.preventDefault();
        else if (event.deltaY < 0) { snapping = false; clearTimeout(unlockTimer); }
        return;
      }
      if (event.deltaY <= 0) return;
      const destination = getDestination();
      if (!destination) return;
      const target = event.target;
      if (target instanceof Element && target.closest("input, textarea, select, [contenteditable='true']")) return;
      event.preventDefault();
      goToNextSection(destination);
    }, { passive: false });

    window.addEventListener("touchstart", (event) => {
      const destination = !snapping && !reduceMotion.matches && !menuIsOpen() ? getDestination() : null;
      touchStart = destination && event.touches.length === 1
        ? { y: event.touches[0].clientY, destination } : null;
    }, { passive: true });
    window.addEventListener("touchend", (event) => {
      if (touchStart && event.changedTouches.length === 1 &&
          touchStart.y - event.changedTouches[0].clientY > 50 && !menuIsOpen() &&
          touchStart.destination.getBoundingClientRect().top > 8) {
        goToNextSection(touchStart.destination);
      }
      touchStart = null;
    }, { passive: true });
  }
</script>
