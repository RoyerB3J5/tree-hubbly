---

import Button from "../../components/Button.astro";
import LayoutSec from "../../layouts/LayoutSec.astro";
// Edita aquí los textos, enlaces e imágenes de la página /app.
const content = {
  title:"Nosotros",
  description:"TreeHubbly ayuda a empresas de tree services en todo Estados Unidos a crecer con marketing, leads calificados, sistemas y automatización. Entendemos tu industria y hablamos tu idioma.",
  links:[
    {
      icon:"facebook",
      title:'Facebook',
      description:'Síguenos para tips, novedades y detrás de cámaras.',
      href:'https://www.facebook.com/treehubly'
    },
    {
      icon:"web",
      title:'Sitio Web',
      description:'Visita nuestro sitio para conocer más sobre Treehubly.',
      href:'/en/'
    },
    {
      icon:"services",
      title:'Nuestros servicios',
      description:'Marketing, leads, sistemas y automatización para tree pros.',
      href:'/en/plans'
    },
    {
      icon:"whats",
      title:'WhatsApp',
      description:'Chatea con nosotros directamente. Estamos aquí para ayduarte.',
      href:'https://wa.me/14075023684'
    }
  ],
  videoDescription:'Más Tree Pros. Negocios más fuertes. <span class="text-secondary"> <br /> Un mañana más verde.</span>',
  videoUrl: "https://pub-9825dca4a1fb47b09d6ba9861c502df4.r2.dev/banner.mp4",
};

---
<LayoutSec>
  <section class="w-full flex flex-col justify-center items-center gap-6 py-6  md:w-[500px] md:px-0 text-paragraph">
    <div class="w-full flex flex-col justify-center items-start gap-6 px-4 md:px-0">
      <a href="/app/" data-back-link aria-label="Volver">
        <img src="/images/icons/back.svg" alt="Back" class="w-[46px] h-[46px]" width="24" height="24" decoding="async" loading="lazy" />
      </a>
      
      <h1 class="text-paragraph text-[32px] font-bold leading-[120%]">{content.title}</h1>
      <p class='body-sm text-[#8DA2B8]'>{content.description}</p>
      <div class="flex flex-col justify-center items-center gap-4">
        {
          content.links.map((item,index)=>(
            <a class="flex justify-between items-center gap-4 p-4 rounded-2xl bg-[#071E31] border border-[#152D47] w-full" href={item.href}>
              <div class='w-14 h-14 bg-secondary rounded-full flex justify-center items-center shrink-0'>
                <img src={`/images/icons/${item.icon}.svg`} alt={item.title} class="w-auto h-[16px]" width="24" height="24" decoding="async" loading="lazy" />
              </div>
                
                <div class="flex flex-col justify-center items-start gap-4">
                  <p class="font-semibold text-paragraph">{item.title}</p>
                  <p class="text-[#8DA2B8] body-sm">{item.description}</p>
                </div>
                <img src={"/images/icons/arrow-book.svg"} alt="arrow button" class="w-[46px] h-[46px]" width="24" height="24" decoding="async" loading="lazy" />
              </a>
          ))
        }
      </div>
    </div>
    <div class='w-full flex justify-start items-end h-[30vh] md:h-[30vh] relative'>
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster="/images/fondo-hero.webp"
        aria-label="Where Tree Companies Scale"
        class="home-scale__video w-full h-full object-cover object-center z-0 absolute inset-0"
      >
        <source src={content.videoUrl} type="video/mp4">
        Tu navegador no puede reproducir este video.
      </video>
      <div class="absolute w-full h-full inset-0 z-1 back-main-3"></div>
      <div class="w-full flex justify-start items-center p-6 gap-2.5 relative z-5">
          <img src="/images/icons/logo-white.svg" alt="Logo" class="w-auto h-[36px]" width="24" height="36" decoding="async" loading="lazy" />
          <p set:html={content.videoDescription} class="text-[16px] font-semibold leading-[150%] text-paragraph"></p> 
        </div>
    </div>
  </section>
</LayoutSec>

<script is:inline>
  document.querySelector("[data-back-link]")?.addEventListener("click", (event) => {
    if (window.history.length > 1) {
      event.preventDefault();
      window.history.back();
    }
  });
</script>
