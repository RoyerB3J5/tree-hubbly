---
// Imports optimizados - solo lo esencial al inicio
import FooterApp from "../components/FooterApp.astro";
import SEOHead from "../components/SEOHead.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es" class="overflow-x-hidden">
  <head>
    <SEOHead viewportFitCover />
  </head>
  <body
    class="font-family antialiased overflow-x-hidden bg-primary flex flex-col justify-center items-center w-screen"
  >
    <main class="app-main flex flex-col w-full items-center h-full justify-center">
      <slot />
    </main>
    <FooterApp />
  </body>
</html>

<style>
  .app-main {
    padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
  }
</style>
