---
import "../styles/global.css";
import SEOHead from "../components/SEOHead.astro";

export interface Props {
  lang?: string;
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonicalPath?: string;
  canonicalUrl?: string;
  includeLanguageAlternates?: boolean;
  includeLocationMetadata?: boolean;
  websiteLanguage?: string;
  structuredData?: object | object[];
  noindex?: boolean;
  logoAlt?: string;
  mainClass?: string;
}

const contentUS = {
  lang: "en",
  title: "Schedule a Meeting | Treehubly - Generate More Leads & Booked Jobs",
  description:
    "Schedule your meeting with Treehubly. Discover the proven marketing system tree service owners use to generate more leads and booked jobs in just 60 days.",
  keywords:
    "schedule tree service consultation, tree service marketing, tree service leads, booked jobs, lead generation, tree company growth, Treehubly scheduling",
  image: "/images/fondo.png",
  canonicalPath: "/scheduling",
  logoAlt: "Treehubly Logo",
};

const contentEs = {
  lang: "es",
  title: "Agenda una Reunión | Treehubly - Genera Más Leads y Trabajos Agendados",
  description:
    "Agenda tu reunión con Treehubly. Descubre el sistema de marketing probado que los dueños de tree services usan para generar más leads y trabajos agendados en solo 60 días.",
  keywords:
    "agendar consulta tree service, marketing para tree services, leads para tree services, trabajos agendados, generación de leads, crecimiento de tree services, Treehubly agenda",
  image: "/images/fondo.png",
  canonicalPath: "/scheduling",
  logoAlt: "Logotipo de Treehubly",
};

const content = contentEs;

const {
  lang = content.lang,
  title = content.title,
  description = content.description,
  keywords = content.keywords,
  image = content.image,
  canonicalPath = content.canonicalPath,
  canonicalUrl,
  includeLanguageAlternates,
  includeLocationMetadata,
  websiteLanguage,
  structuredData,
  noindex,
  logoAlt = content.logoAlt,
  mainClass = "flex flex-col w-full justify-center items-center relative z-0",
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="overflow-x-clip">
  
  <head>
    <SEOHead
      lang={lang}
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      canonicalPath={canonicalPath}
      canonicalUrl={canonicalUrl}
      includeLanguageAlternates={includeLanguageAlternates}
      includeLocationMetadata={includeLocationMetadata}
      websiteLanguage={websiteLanguage}
      structuredData={structuredData}
      noindex={noindex}
    />
    <!-- Meta Pixel Code -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js",
      );
      fbq('init', '998111372541287');
      if (window.top === window.self) {
        fbq('track', 'PageView');
      }
    </script>
    
  </head>

  <body
    class="font-family antialiased overflow-x-clip bg-white flex flex-col justify-center items-center w-full scroll-smooth"
  >
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=998111372541287&ev=PageView&noscript=1"
      />
    </noscript>
    <header
      class="w-full absolute top-0 left-0 flex justify-center items-center pt-4 z-10"
    >
      <a href="/scheduling/programme/" class="cursor-pointer">
        <img
          src="/images/logo.svg"
          alt={logoAlt}
          width="190"
          height="40"
          class="w-[136px] md:w-[154px] h-auto"
          decoding="async"
          loading="eager"
        />
      </a>
    </header>
    <main class={mainClass}>
      <slot />
    </main>
    <slot name="footer" />
  </body>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const animationElements = document.querySelectorAll(
        ".animation-up-fast, .animation-fade-down, .animation-fade-left, .animation-fade-right",
      );

      const animationObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("active");
              animationObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 },
      );

      animationElements.forEach((element) => {
        animationObserver.observe(element);
      });
    });
  </script>

  <script is:inline>
    (() => {
      const sourceByPath = {
        "/scheduling/programme": "programme",
        "/scheduling/questionnaire": "questionnaire",
      };
      const currentPath = window.location.pathname.replace(/\/+$/, "");
      const currentSource = sourceByPath[currentPath];
      const storageKey = "treehubly:pending-lead-transition:v1";
      const maxAgeMs = 4 * 60 * 60 * 1000;
      const trustedOrigins = [
        window.location.origin,
        "https://treehubly.com",
        "https://www.treehubly.com",
      ];

      if (currentSource) {
        try {
          window.sessionStorage.setItem(
            storageKey,
            JSON.stringify({ source: currentSource, createdAt: Date.now() }),
          );
        } catch {
          // Tracking should not affect page rendering when storage is unavailable.
        }
      }

      window.addEventListener("message", (event) => {
        if (
          !trustedOrigins.includes(event.origin) ||
          event.data?.type !== "treehubly:crm-thank-you" ||
          !currentSource
        ) {
          return;
        }

        let shouldTrackLead = false;
        try {
          const pending = JSON.parse(
            window.sessionStorage.getItem(storageKey) ?? "null",
          );
          if (
            pending?.source !== currentSource ||
            !Number.isFinite(pending?.createdAt) ||
            Date.now() - pending.createdAt > maxAgeMs
          ) {
            shouldTrackLead = false;
          } else {
            window.sessionStorage.removeItem(storageKey);
            shouldTrackLead = true;
          }
        } catch {
          // Continue to the confirmation page even if browser storage is unavailable.
        }

        if (shouldTrackLead && typeof window.fbq === "function") {
          window.fbq("track", "Lead");
        }
        window.setTimeout(() => {
            window.location.assign("/scheduling/thank-you/");
        }, 250);
      });
    })();
  </script>


</html>
