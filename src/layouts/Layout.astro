---
// Imports optimizados - solo lo esencial al inicio
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import DesktopMenu from "../components/DesktopMenu.astro";
import Chatbot from "../components/Chatbot.astro";

type Translations = typeof import("../i18n/en-2").default;

export interface Props {
  lang: string;
  t?: Translations;
  pageClass?: string;
}

const { lang, t, pageClass } = Astro.props;
---

<!doctype html>
<html lang={lang} class="overflow-x-clip scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Crítico: CSS inline para evitar FOUC -->
    <style is:inline>
      body {
        visibility: hidden;
      }
      body.visible {
        visibility: visible;
      }
      html { background: var(--color-primary); scrollbar-width: none; }
      html::-webkit-scrollbar { display: none; }
      @media (prefers-reduced-motion: no-preference) {
        #site-main > .hero-main { position: sticky; top: 0; z-index: 1; }
        #site-main > .hero-main ~ section,
        #site-main > .hero-main ~ .questions-section { position: relative; z-index: 2; }
        #site-main > .pin-spacer:has(> .home-steps),
        #site-main.home-page-sections > .pin-spacer:has(> .reasons-section),
        #site-main.home-page-sections > .pin-spacer:has(> .control-section),
        #site-main.home-page-sections > .pin-spacer:has(> .path-section),
        #site-main > .pin-spacer:has(> .system-reasons) { position: relative; z-index: 3; flex-shrink: 0; }
      }
        html.desktop-menu-open { overflow: hidden; }
        body.desktop-menu-open .header-cta { display: none; }
        #page-content { --menu-height: 320px; width: 100%; transform-origin: center var(--menu-origin-y, 0px); transition: transform 0.5s ease; }
        #site-main { min-height: 100svh; background: var(--color-primary); }
        #site-main > section:first-of-type:not(.hero-main) { position: relative; }
        #site-main > section:first-of-type { z-index: 1; }
        body.desktop-menu-open #page-content {
          transform: translateY(var(--menu-height)) scale(var(--menu-scale, 1));
          clip-path: inset(var(--menu-origin-y, 0px) 0 0 round 16px 16px 0 0);
        }
        #desktop-menu { visibility: hidden; opacity: 0; transition: opacity 0.3s ease, visibility 0s linear 0.3s; }
        body.desktop-menu-open #desktop-menu { visibility: visible; opacity: 1; transition-delay: 0s; }
      @media (min-width: 768px) { #page-content { --menu-height: 280px; } }
      @media (prefers-reduced-motion: reduce) {
        #page-content, #desktop-menu { transition: none; }
      }
    </style>

    <!-- SEO Local para Orlando -->
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content="Orlando" />
    <meta name="geo.position" content="28.5383;-81.3792" />
    <meta name="ICBM" content="28.5383, -81.3792" />

    <!-- Preconnect para DNS lookup temprano -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preconnect para widget de chat - optimización de terceros -->
    <link rel="preconnect" href="https://widgets.leadconnectorhq.com" />
    <link rel="dns-prefetch" href="https://widgets.leadconnectorhq.com" />
    <!-- Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />
    <title>Treehubly - The Growth System for Tree Services</title>
    <meta
      name="description"
      content="Treehubly helps tree companies generate better leads, book more jobs, and scale with a structured growth ecosystem."
    />
    <!-- SEO additions -->
    <meta
      name="keywords"
      content="Tree Services, Lead Generation, Growth System, Marketing Automation, Tree Company Growth, Tree Service Marketing, Tree Service Leads, Tree Service Automation, Tree Service Performance, TreeHubly Growth System"
    />
    <meta name="author" content="Treehubly" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://treehubly.com/" />

    <!-- Alternate language versions -->
    <link rel="alternate" hreflang="en" href="https://treehubly.com/en/" />
    <link rel="alternate" hreflang="es" href="https://treehubly.com/es/" />
    <link
      rel="alternate"
      hreflang="x-default"
      href="https://treehubly.com/en/"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Treehubly - The Growth System for Tree Services"
    />
    <meta
      property="og:description"
      content="Treehubly helps tree companies generate better leads, book more jobs, and scale with a structured growth ecosystem."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://treehubly.com/" />
    <meta property="og:image" content="/images/fondo.png" />
    <meta property="og:locale" content={lang === "es" ? "es_US" : "en_US"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Treehubly" />
    <meta
      name="twitter:title"
      content="Treehubly - The Growth System for Tree Services"
    />
    <meta
      name="twitter:description"
      content="Treehubly helps tree companies generate better leads, book more jobs, and scale with a structured growth ecosystem."
    />
    <meta name="twitter:image" content="/images/fondo.png" />

    <!-- JSON-LD Organization -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Treehubly",
        "url": "https://treehubly.com/",
        "logo": "https://treehubly.com/favicon.svg"
      }
    </script>
  </head>
  <body
    class="font-family antialiased overflow-x-clip bg-primary flex flex-col justify-center items-center w-full"
  >
    <Header content={t?.header} />
    {t && <DesktopMenu contentHeader={t.header} />}
    <div id="page-content">
      <main
        id="site-main"
        class:list={["relative flex flex-col w-full items-center", pageClass]}
      >
        <slot />
      </main>
      <Footer content={t?.footer} />
    </div>
    
    {/*<Chatbot />  */}
    

    <script>
      function showContent() {
        document.body.classList.add("visible");
      }

      // Inicialización optimizada
      function initializeApp() {
        // Mostrar contenido inmediatamente
        showContent();
      }

      // Inicialización según el estado del documento
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeApp);
      } else {
        initializeApp();
      }

      // Fallback garantizado para mostrar contenido
      setTimeout(showContent, 500);
    </script>
  </body>
</html>

<!-- Consolidated IntersectionObserver for all animations and carousels -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Observer para animaciones: services-header, animation-left, hero-content
    const animationElements = document.querySelectorAll(
      ".fade-up-a, .fade-down-a, .fade-left-a, .fade-right-a"
    );

    if (!("IntersectionObserver" in window)) {
      animationElements.forEach((element) => element.classList.add("active"));
    } else {
      const animationObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("active");
              animationObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 }
      );

      animationElements.forEach((element) => {
        if (element.closest("[data-reveal-sequence]")) return;
        if (element.closest(".reasons-section.is-pinned .reasons-slide, .system-reasons.is-pinned .system-reasons-slide")) return;
        animationObserver.observe(element);
      });
    }

    if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const imageObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const target = entry.target;
          const element = target.classList.contains("animation-image-reveal")
            ? target : target.querySelector(".animation-image-reveal");
          observer.unobserve(target);
          if (!element) return;
          const image = element.querySelector(":scope > img, :scope > .animation-image-reveal-mask > img");
          const reveal = () => {
            // Commit the prepared scale before activating, even on a reload
            // where the target is already visible and the image is cached.
            getComputedStyle(element).transform;
            element.classList.add("active");
          };
          if (image && !image.complete && !element.hasAttribute("data-reveal-without-image")) {
            image.addEventListener("load", reveal, { once: true });
            image.addEventListener("error", reveal, { once: true });
            if (image.complete) reveal();
          } else {
            reveal();
          }
        });
      }, { threshold: 0.3 });

      document.querySelectorAll(".animation-image-reveal").forEach((element) => {
        if (!element.querySelector(":scope > img, :scope > .animation-image-reveal-mask")) return;
        element.classList.add("reveal-ready");
        if (element.closest("[data-reveal-sequence]")) return;
        if (element.closest(".reasons-section.is-pinned, .system-reasons.is-pinned")) return;
        imageObserver.observe(element.closest(".animation-image-reveal-trigger") || element);
      });
    }

    // Observer para carousels: .hero-carousel[data-interval]
    const carousels = Array.from(document.querySelectorAll(".hero-carousel[data-interval]"));

    if (carousels.length > 0 && "IntersectionObserver" in window) {
      const carouselObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // Trigger custom event or initialization if needed
              entry.target.dispatchEvent(new CustomEvent("carouselVisible"));
              obs.unobserve(entry.target);
            }
          });
        },
        { root: null, rootMargin: "400px" }
      );

      carousels.forEach((c) => carouselObserver.observe(c));
    }
  });
</script>


<script>
  import "../scripts/textReveal.js";
</script>
