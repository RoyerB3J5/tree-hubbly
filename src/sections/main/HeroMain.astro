---
import Button from "../../components/Button.astro";
type Translations = typeof import("../../i18n/en-2").default;
type HeroContent = Translations["main"]["hero"];
interface Props {
  content: HeroContent ;
  showDescriptionOnMobile?: boolean;
}
const { content, showDescriptionOnMobile = false } = Astro.props as Props;

---

<section class="hero-main hero-sequence w-full relative bg-primary">
  <div class="hero-sequence__viewport w-full flex items-center justify-center text-paragraph">
    <img src="/images/hero-frames/frame_0000.webp" alt="" aria-hidden="true" fetchpriority="high" width="1904" height="1072" class="hero-sequence__media object-cover object-center" />
    <canvas class="hero-sequence__media hero-sequence__canvas" aria-hidden="true"></canvas>
    <video class="hero-sequence__media hero-sequence__video object-cover object-center" muted playsinline preload="none" data-src="https://pub-9825dca4a1fb47b09d6ba9861c502df4.r2.dev/video_hero.mp4" poster="/images/hero-frames/frame_0000.webp" aria-hidden="true" tabindex="-1"></video>
    <div class="absolute w-full h-full inset-0 z-3 back-hero"></div>
    <div
      class="container-full flex flex-col justify-end items-center pb-12 md:py-14 relative z-10 h-full"
    >
      <div class="flex flex-col justify-center items-center gap-8 md:gap-10">
        <div class='flex flex-col justify-center items-center gap-6'>
          {
            content.tag !== "" && (
              <p class={`text-[16px] font-medium leading-[150%] text-secondary fade-up-lines-raw`}>{content.tag}</p>
            )
          }
          <h1 set:html={content.title} class="heading-h4 text-white text-center fade-up-lines-raw"></h1>
        </div>
        {
          content.description !== "" && (
            <p set:html={content.description} class:list={["text-paragraph body-md text-center fade-up-lines-raw", { "hidden md:block": !showDescriptionOnMobile }]}></p>
          )
        }
        {
          content.items.length > 0 && (
            <ul class="md:flex justify-center items-center gap-10 w-full hidden ">
              {
                content.items.map((item,index) => (
                  <>
                  <li class=" flex justify-center items-center gap-2">
                    
                    <img src={`/images/icons/items-h-${index + 1}.svg`} alt={`Item ${index + 1}`} width="24" height="24" class="w-8 h-8 fade-up-a">
                    <span class="fade-up-lines-raw text-[18px] font-semibold leading-[150%] text-paragraph text-center">{item}</span>
                  </li>
                  <div class='h-full w-[1px] bg-paragraph/40 last:hidden'></div>
                  </>
                  
                ))
              }
            </ul>
          )
        }
        {
          content.buttons.length > 0 && (
            <div class="w-full md:w-auto flex flex-col md:flex-row justify-center items-center gap-4 md:gap-4">
              <Button
                    text={content.buttons[0].label}
                    href={content.buttons[0].href}
                    extraBtnClass="bg-secondary border-secondary fade-up-a w-full md:w-auto"
                    textClass="text-primary"
                  />
              <Button
                    text={content.buttons[1].label}
                    href={content.buttons[1].href}
                    extraBtnClass="bg-transparent border-white fade-up-a w-full md:w-auto"
                    textClass="white"
                  />
            </div>
          )
        }
      </div>   
    </div>
  </div>
  
</section>

<style>
  .hero-sequence { height: 100svh; }
  .hero-sequence__viewport { position: relative; height: 100svh; overflow: hidden; }
  .hero-sequence__media { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-sequence__canvas, .hero-sequence__video { visibility: hidden; pointer-events: none; }
  .hero-sequence__canvas.is-visible, .hero-sequence__video.is-visible { visibility: visible; }
</style>

<script>
  import { gsap, ScrollTrigger } from "../../scripts/gsap";

  const FRAME_COUNT = 73;
  const INTRO_END = 5;

  document.querySelectorAll<HTMLElement>(".hero-sequence").forEach((hero) => {
    const canvas = hero.querySelector<HTMLCanvasElement>(".hero-sequence__canvas");
    const video = hero.querySelector<HTMLVideoElement>(".hero-sequence__video");
    const context = canvas?.getContext("2d");
    if (!canvas || !video || !context) return;

    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      const frames = new Map<number, HTMLImageElement>();
      const pending = new Set<number>();
      const failed = new Set<number>();
      const anchors = [0, 12, 24, 36, 48, 60, 72];
      const maxFrames = 24;
      let current = 0;
      let active = true;
      let introFinished = false;
      let nearHero = true;
      let loading = 0;
      let introTick = 0;
      let drawTick = 0;
      let lastDrawn = -1;

      const draw = (force = false) => {
        let nearest = -1;
        for (const index of frames.keys()) {
          if (nearest < 0 || Math.abs(index - current) < Math.abs(nearest - current)) nearest = index;
        }
        const image = frames.get(nearest);
        if (!image || !canvas.width || !canvas.height) return false;
        if (!force && nearest === lastDrawn) return true;
        const scale = Math.max(canvas.width / image.naturalWidth, canvas.height / image.naturalHeight);
        const width = image.naturalWidth * scale;
        const height = image.naturalHeight * scale;
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.drawImage(image, (canvas.width - width) / 2, (canvas.height - height) / 2, width, height);
        lastDrawn = nearest;
        canvas.classList.add("is-visible");
        return true;
      };
      const scheduleDraw = () => {
        if (drawTick) return;
        drawTick = requestAnimationFrame(() => { drawTick = 0; if (active) draw(); });
      };

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2, Math.sqrt(2073600 / (rect.width * rect.height)));
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        draw(true);
      };

      const trimFrames = () => {
        while (frames.size > maxFrames) {
          const candidates = [...frames.keys()].filter((index) => !anchors.includes(index) && index !== current);
          if (!candidates.length) break;
          candidates.sort((a, b) => Math.abs(b - current) - Math.abs(a - current));
          frames.delete(candidates[0]);
        }
      };
      const wantedFrames = () => {
        const nearby = [current];
        for (let distance = 1; distance <= 8; distance++) nearby.push(current + distance, current - distance);
        // A few distributed previews make large scroll jumps usable while nearby frames load.
        return [current, ...anchors, ...nearby].filter((index, position, list) =>
          index >= 0 && index < FRAME_COUNT && list.indexOf(index) === position);
      };
      const pump = () => {
        while (active && nearHero && loading < 3) {
          const index = wantedFrames().find((item) => !frames.has(item) && !pending.has(item) && !failed.has(item));
          if (index === undefined) break;
          const image = new Image();
          pending.add(index);
          loading++;
          image.onload = () => {
            loading--;
            pending.delete(index);
            if (!active) return;
            frames.set(index, image);
            trimFrames();
            scheduleDraw();
            pump();
          };
          image.onerror = () => { loading--; pending.delete(index); failed.add(index); if (active) pump(); };
          image.src = `/images/hero-frames/frame_${String(index).padStart(4, "0")}.webp`;
        }
      };
      const finishIntro = () => {
        if (!active || introFinished) return;
        introFinished = true;
        cancelAnimationFrame(introTick);
        video.pause();
        draw();
        video.classList.remove("is-visible");
        pump();
      };
      const checkIntro = () => {
        if (video.currentTime >= INTRO_END) finishIntro();
        else if (active && !introFinished) introTick = requestAnimationFrame(checkIntro);
      };

      hero.classList.add("is-sequence-ready");
      resize();
      pump();
      window.addEventListener("resize", resize);
      video.addEventListener("ended", finishIntro);
      video.addEventListener("error", finishIntro);
      video.src = video.dataset.src || "";
      video.classList.add("is-visible");
      video.play().then(() => { if (active && !introFinished) introTick = requestAnimationFrame(checkIntro); }).catch(finishIntro);

      const state = { frame: 0 };
      const tween = gsap.to(state, {
        frame: FRAME_COUNT - 1,
        ease: "none",
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: () => `+=${hero.offsetHeight}`,
          scrub: 0.5,
          invalidateOnRefresh: true,
          onLeave: () => { nearHero = false; },
          onEnterBack: () => { nearHero = true; pump(); },
        },
        onUpdate: () => {
          const next = Math.round(state.frame);
          if (next === current) return;
          current = next;
          if (current > 0) finishIntro();
          trimFrames();
          pump();
          scheduleDraw();
        },
      });
      ScrollTrigger.sort();
      ScrollTrigger.refresh();

      return () => {
        active = false;
        cancelAnimationFrame(introTick);
        cancelAnimationFrame(drawTick);
        tween.scrollTrigger?.kill();
        tween.kill();
        window.removeEventListener("resize", resize);
        video.removeEventListener("ended", finishIntro);
        video.removeEventListener("error", finishIntro);
        video.pause();
        video.removeAttribute("src");
        video.load();
        frames.clear();
        video.classList.remove("is-visible");
        canvas.classList.remove("is-visible");
        hero.classList.remove("is-sequence-ready");
        ScrollTrigger.refresh();
      };
    });
  });
</script>
