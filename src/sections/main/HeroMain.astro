---
import Button from "../../components/Button.astro";
type Translations = typeof import("../../i18n/en-2").default;
type HeroContent = Translations["main"]["hero"];
interface Props {
  content: HeroContent ;
  showDescriptionOnMobile?: boolean;
}
const { content, showDescriptionOnMobile = false } = Astro.props as Props;

---

<section class="hero-main hero-sequence w-full relative bg-primary">
  <div class="hero-sequence__viewport w-full flex items-center justify-center text-paragraph">
    <video class="hero-sequence__media object-cover object-center" src="https://pub-9825dca4a1fb47b09d6ba9861c502df4.r2.dev/video_hero.mp4" autoplay muted loop playsinline preload="auto" aria-hidden="true" tabindex="-1"></video>
    <div class="absolute w-full h-full inset-0 z-3 back-hero"></div>
    <div
      class="container-full flex flex-col justify-end items-center pb-12 md:py-14 xl:[@media(height_<_810px)]:py-10 relative z-10 h-full"
    >
      <div class="flex flex-col justify-center items-center gap-8 md:gap-10 xl:[@media(height_<_810px)]:gap-6">
        <div class='flex flex-col justify-center items-center gap-6'>
          {
            content.tag !== "" && (
              <p class={`text-[16px] font-medium leading-[150%] text-secondary fade-up-lines-raw`}>{content.tag}</p>
            )
          }
          <h1 set:html={content.title} class="heading-h4 text-white text-center fade-up-lines-raw"></h1>
        </div>
        {
          content.description !== "" && (
            <p set:html={content.description} class:list={["text-paragraph body-md text-center fade-up-lines-raw", { "hidden md:block": !showDescriptionOnMobile }]}></p>
          )
        }
        {
          content.items.length > 0 && (
            <ul class="md:flex justify-center items-center gap-10 w-full hidden ">
              {
                content.items.map((item,index) => (
                  <>
                  <li class=" flex justify-center items-center gap-2 fade-up-a">
                    
                    <img src={`/images/icons/items-h-${index + 1}.svg`} alt={`Item ${index + 1}`} width="24" height="24" class="w-8 h-8 ">
                    <span class="fade-up-lines-raw text-[18px] font-semibold leading-[150%] text-paragraph text-center">{item}</span>
                  </li>
                  <div class='h-full w-[1px] bg-paragraph/40 last:hidden'></div>
                  </>
                  
                ))
              }
            </ul>
          )
        }
        {
          content.buttons.length > 0 && (
            <div class="w-full md:w-auto flex flex-col md:flex-row justify-center items-center gap-4 md:gap-4">
              <Button
                    text={content.buttons[0].label}
                    href={content.buttons[0].href}
                    extraBtnClass="bg-secondary border-secondary fade-up-a w-full md:w-auto"
                    textClass="text-primary"
                  />
              <Button
                    text={content.buttons[1].label}
                    href={content.buttons[1].href}
                    extraBtnClass="bg-transparent border-white fade-up-a w-full md:w-auto"
                    textClass="white"
                  />
            </div>
          )
        }
      </div>   
    </div>
  </div>
  
</section>

<style>
  .hero-sequence { height: 100svh; }
  .hero-sequence__viewport { position: relative; height: 100svh; overflow: hidden; }
  .hero-sequence__media { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-sequence__media { pointer-events: none; }
</style>

<script>
  document.querySelectorAll<HTMLVideoElement>(".hero-sequence video").forEach((video) => {
    let retries = 0;
    let retryTimer: ReturnType<typeof setTimeout> | undefined;
    let resumeTime = 0;

    const resume = () => {
      if (document.hidden || video.error || !video.paused) return;
      video.play().catch(() => {
        // Autoplay can be temporarily blocked by the browser; retry on return or interaction.
      });
    };

    video.addEventListener("pause", () => {
      if (!document.hidden && !video.ended) {
        clearTimeout(retryTimer);
        retryTimer = setTimeout(resume, 500);
      }
    });
    video.addEventListener("timeupdate", () => { resumeTime = video.currentTime; });
    video.addEventListener("playing", () => { retries = 0; });
    video.addEventListener("error", () => {
      if (retries >= 3) return;
      retries++;
      clearTimeout(retryTimer);
      retryTimer = setTimeout(() => {
        video.load();
        video.addEventListener("loadedmetadata", () => {
          if (resumeTime && resumeTime < video.duration) video.currentTime = resumeTime;
          resume();
        }, { once: true });
      }, 2000 * retries);
    });
    document.addEventListener("visibilitychange", resume);
    window.addEventListener("pageshow", resume);
    document.addEventListener("pointerdown", resume, { passive: true });
    resume();
  });
</script>
