---
import Button from "../../components/Button.astro";
type Translations = typeof import("../../i18n/en-2").default;
type HeroContent = Translations["main"]["hero"];
interface Props {
  content: HeroContent ;
}
const { content } = Astro.props as Props;
---

<section class="w-full h-[calc(100svh)] relative flex items-center justify-center text-white ">
  {/*<video
    autoplay={true}
    muted={true}
    loop={true}
    playsinline={true}
    x-webkit-playsinline={true}
    preload="auto"
    class="block absolute inset-0 w-full h-full object-cover object-center -z-20"
  >
    <source src="/images/video.mp4" type="video/mp4" />
  </video> */}
  <img src="/images/fondo-hero.webp" alt="Hero image" decoding="async" loading="lazy" width="1667" height="943" class='w-full h-full object-cover inset-0 absolute z-0 object-top' />
  <div class="absolute w-full h-full inset-0 z-3 back-hero"></div>
  <div
    class="container-full flex flex-col justify-end items-center py-14 relative z-10 h-full"
  >
    <div class="flex flex-col justify-center items-center gap-10">
      <div class='flex flex-col justify-center items-center gap-6'>
        {
          content.tag !== "" && (
            <p class="text-[16px] font-medium leading-[150%] text-secondary">{content.tag}</p>
          )
        }
        <h1 set:html={content.title} class="heading-h1 text-white text-center"></h1>
      </div>
      {
        content.description !== "" && (
          <p set:html={content.description} class="text-paragraph body-md text-center"></p>
        )
      }
      {
        content.buttons.length > 0 && (
          <div class="w-full md:w-auto flex flex-col md:flex-row justify-center items-center gap-4 md:gap-4">
            <Button
                  text={content.buttons[0].label}
                  href={content.buttons[0].href}
                  extraBtnClass="bg-secondary border-secondary"
                  textClass="text-primary"
                />
            <Button
                  text={content.buttons[1].label}
                  href={content.buttons[1].href}
                  extraBtnClass="bg-transparent border-white"
                  textClass="white"
                />
          </div>
        )
      }
    </div>   
  </div>
</section>