---
type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["steps"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;

const heightFactor = 0.91;
const anotherPage = content.tag =="" ? true : false;
const baseHeight = anotherPage ? 523 : 424;
---
<section class='home-steps w-full flex justify-center items-center bg-third-light min-h-[100svh] md:min-h-0 xl:min-h-[100svh]'>
  <div class={`container-full flex flex-col justify-center md:justify-between ${anotherPage ? 'items-start' : 'items-start md:items-center'} gap-8 md:gap-10 py-12 md:py-20`}>
    <div class='flex flex-col justify-center items-start md:items-center gap-6'>
      {
        !anotherPage && (<p class="subtitle-lg text-primary">{content.tag}</p>)
      }
      <h2 set:html={content.title} class="heading-h4 text-primary text-start md:text-center"></h2>
    </div>
    <p class='body-md text-primary text-start md:text-center' set:html={content.description}></p>
    <div class='w-full grid grid-cols-1 lg:grid-cols-5 justify-center items-center lg:items-end gap-4 md:gap-6 steps-card-list '>
      {
        content.reasons.map((item,index)=>(
          <div
            class="steps-card relative flex flex-col justify-between items-center px-6 py-8 rounded-2xl gap-4 lg:gap-0"
            style={`--steps-card-height: ${baseHeight * Math.pow(heightFactor, content.reasons.length - 1 - index)}px`}
          >
            <div class={`steps-card-background absolute inset-0 rounded-2xl ${index===3?'bg-third':'bg-white'}`} aria-hidden="true"></div>
            <div class="steps-card-content relative w-full flex flex-col justify-center items-start gap-6">
              <div class="flex flex-row md:flex-col justify-start md:justify-center items-center md:items-start gap-4 md:gap-6"> 
                <div class={`w-10 h-10 flex justify-center items-center rounded-lg  ${index===3?'bg-paragraph':'bg-third-light'}`}>
                  <p class="body-lg text-primary">{index+1}</p>
                </div>
                <h3 class='text-[24px] md:text-[20px] font-bold leading-[140%] text-primary'>{item.title}</h3>
              </div>
              
              <p class='body-md text-primary'>{item.description}</p>  
            </div>
            <div class="steps-card-content relative w-full flex justify-between items-center ">
              <p class='subtitle-lg text-primary'>{item.tag}</p>
              <div class={`w-12 h-12  rounde-lg flex justify-center items-center rounded-lg ${index===3?'bg-paragraph':'bg-third-light'}`}>
                <img src={`/images/icons/${item.icon}.svg`} alt={item.title} width="20" height="20" class='w-5 h-5' decoding="async" loading="lazy"/>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>  

<style>
  .steps-card {
    height: auto;
  }

  @media (min-width: 1024px) {
    .steps-card {
      min-height: var(--steps-card-height);
    }
  }

  @media (min-width: 1280px) {
    .steps-card { height: var(--steps-card-height); }
  }

  :global(.steps-scroll-controlled) .steps-card-list { overflow: hidden; }
</style>

<script>
  import { gsap, ScrollTrigger } from "../../scripts/gsap";
  const stepsSection = document.querySelector<HTMLElement>(".home-steps");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  // Reserve the line reveals for the card sequence only when the section fits.
  const canPinSteps = () => Boolean(stepsSection && window.innerWidth >= 1280 &&
    !reduceMotion.matches && stepsSection.offsetHeight <= window.innerHeight);
  if (canPinSteps()) stepsSection?.classList.add("steps-scroll-controlled");

  document.addEventListener("DOMContentLoaded", () => queueMicrotask(() => {
    if (!stepsSection) return;
    const cards = gsap.utils.toArray<HTMLElement>(stepsSection.querySelectorAll(".steps-card"));
    if (!cards.length) return;

    const media = gsap.matchMedia();
    media.add("(min-width: 768px) and (max-width: 1279px) and (prefers-reduced-motion: no-preference)", () => {
      cards.forEach((card, index) => {
        card.classList.add("fade-up-a");
        card.style.setProperty("--fade-up-delay", `${index * 0.2}s`);
      });
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("active");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.3 });
      cards.forEach((card) => observer.observe(card));
      return () => {
        observer.disconnect();
        cards.forEach((card) => {
          card.classList.remove("fade-up-a", "active");
          card.style.removeProperty("--fade-up-delay");
        });
      };
    });

    media.add("(min-width: 1280px) and (prefers-reduced-motion: no-preference)", () => {
      if (!canPinSteps()) {
        stepsSection.classList.remove("steps-scroll-controlled");
        stepsSection.querySelectorAll(".steps-card .fade-up-lines-raw").forEach((text) => text.classList.add("active"));
        return;
      }

      stepsSection.classList.add("steps-scroll-controlled");
      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: stepsSection,
          refreshPriority: 1,
          start: "top top",
          end: () => `+=${window.innerHeight * cards.length * 0.6}`,
          pin: true,
          pinSpacing: true,
          scrub: true,
          invalidateOnRefresh: true,
        },
      });

      cards.forEach((card, index) => {
        const content = card.querySelectorAll(".steps-card-content");
        const text = card.querySelectorAll<HTMLElement>("h1.fade-up-lines-raw, h2.fade-up-lines-raw, h3.fade-up-lines-raw, h4.fade-up-lines-raw, h5.fade-up-lines-raw, h6.fade-up-lines-raw, p.fade-up-lines-raw");
        text.forEach((element, textIndex) => {
          element.classList.remove("active");
          element.style.setProperty("--fade-up-lines-delay", `${textIndex * 0.18}s`);
        });
        gsap.set(card, { yPercent: 100 });
        gsap.set(content, { autoAlpha: 0 });
        timeline.to(card, { yPercent: 0, duration: 0.45, ease: "none" }, index)
          .set(content, { autoAlpha: 1 }, index + 0.45)
          .call(() => text.forEach((element) => element.classList.add("active")), [], index + 0.45)
          .to({}, { duration: 0.55 }, index + 0.45);
      });

      let lockedUntil = 0;
      const onWheel = (event: WheelEvent) => {
        const trigger = timeline.scrollTrigger;
        if (!trigger || document.documentElement.classList.contains("section-transitioning") || event.ctrlKey || document.documentElement.classList.contains("desktop-menu-open") ||
            document.getElementById("mobile-menu")?.classList.contains("translate-x-0")) return;
        const now = performance.now();
        if (now < lockedUntil) { event.preventDefault(); return; }
        if (!trigger.isActive || Math.abs(event.deltaY) < 2) return;
        if ((event.deltaY < 0 && trigger.progress <= 0.001) ||
            (event.deltaY > 0 && trigger.progress >= 0.999)) return;
        const current = Math.round(trigger.progress * cards.length);
        const step = gsap.utils.clamp(0, cards.length, current + (event.deltaY > 0 ? 1 : -1));
        event.preventDefault();
        lockedUntil = now + 900;
        window.scrollTo({ top: trigger.start + (trigger.end - trigger.start) * step / cards.length, behavior: "smooth" });
      };
      window.addEventListener("wheel", onWheel, { passive: false, capture: true });
      ScrollTrigger.sort();
      ScrollTrigger.refresh();
      return () => {
        window.removeEventListener("wheel", onWheel, true);
        stepsSection.classList.remove("steps-scroll-controlled");
        stepsSection.querySelectorAll(".steps-card .fade-up-lines-raw").forEach((text) => text.classList.add("active"));
      };
    });
  }));

</script>
