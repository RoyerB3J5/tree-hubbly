---
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en-2").default;
type CallContent = Translations["main"]["business"];
interface Props {
  content: CallContent;
}
const { content } = Astro.props as Props;
---

<section
  class="w-full flex justify-center items-center relative overflow-hidden bg-secondary"
>
  <div class="call-action-marquee" aria-hidden="true">
    <div class="call-action-marquee-track">
      <img src="/images/letter.webp" alt="" width="1440" height="308" decoding="async" loading="lazy" />
      <img src="/images/letter.webp" alt="" width="1440" height="308" decoding="async" loading="lazy" />
    </div>
  </div>
  <div class="container-full flex flex-col justify-center items-center gap-10 pt-16 md:pt-30 pb-16 md:pb-[223px]">
    <div class='flex flex-col justify-center items-center gap-8 md:gap-6 '>
      <h2
        set:html={content.title}
        class="text-primary heading-h4 text-center"
      ></h2>
      {
        content.description !== "" && (
          <p
            set:html={content.description}
            class="body-md text-primary text-center "
          ></p>
        )
      }
    </div>
    <div class="w-full md:w-auto flex flex-col md:flex-row justify-center items-center gap-4 ">
        {content.buttons.map((button,index) => (
          <Button
            text={button.label}
            href={button.href}
            extraBtnClass={`${index === 0 ? "bg-primary border-primary fade-up-a w-full md:w-auto" : "bg-transparent border-primary fade-up-a w-full md:w-auto"}`}
            textClass={`${index === 0 ? "text-white" : "text-primary"}`}
          />
        ))}
      </div>
  </div>
</section>
<style>
  .call-action-marquee {
    position: absolute; inset: 0; transform: translateY(50%);
    overflow: hidden; opacity: 0.3; pointer-events: none;
  }
  .call-action-marquee-track {
    --marquee-gap: clamp(2rem, 6vw, 6rem);
    display: flex; width: max-content; height: 100%; gap: var(--marquee-gap);
    animation: call-action-scroll 24s linear infinite;
  }
  .call-action-marquee-track img {
    display: block; width: 100vw; height: 100%; flex: none;
    object-fit: contain; object-position: center;
  }
  @keyframes call-action-scroll {
    to { transform: translateX(calc(-100vw - var(--marquee-gap))); }
  }
  @media (prefers-reduced-motion: reduce) {
    .call-action-marquee-track { animation: none; }
  }
</style>
