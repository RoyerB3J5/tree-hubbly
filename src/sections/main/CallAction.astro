---
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en-2").default;
type CallContent = Translations["main"]["business"];
interface Props {
  content: CallContent;
}
const { content } = Astro.props as Props;
---

<section
  class="w-full flex justify-center items-center relative overflow-hidden bg-secondary"
>
  <img
      src="/images/letter.webp"
      alt="Letter"
      class="absolute bottom-0 right-0 w-full h-full object-contain object-center translate-y-1/2 opacity-30"
      width="1440"
      height="308"
      decoding="async"
      loading="lazy"
  />
  <div class="container-full flex flex-col justify-center items-center gap-10 pt-30 pb-[223px]">
    <div class='flex flex-col justify-center items-center gap-6 '>
      <h2
        set:html={content.title}
        class="text-primary heading-h4 text-center"
      ></h2>
      {
        content.description !== "" && (
          <p
            set:html={content.description}
            class="body-md text-primary"
          ></p>
        )
      }
    </div>
    <div class="w-full md:w-auto flex flex-col md:flex-row justify-center items-center gap-4 ">
        {content.buttons.map((button,index) => (
          <Button
            text={button.label}
            href={button.href}
            extraBtnClass={`${index === 0 ? "bg-primary border-primary" : "bg-transparent border-primary"}`}
            textClass={`${index === 0 ? "text-white" : "text-primary"}`}
          />
        ))}
      </div>
  </div>
</section>