---
import FormContact from "../../components/FormContact.astro";

type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["session"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<div data-reveal-sequence class="book-sequence container-full flex flex-col md:flex-row justify-center items-start md:items-stretch gap-[32px] lg:gap-6" >
  <div class="w-full md:w-[50%] flex flex-col justify-center items-start gap-8 md:gap-10 xl:[@media(height_<_810px)]:gap-6">
    <div class="book-heading flex flex-col justify-center items-start gap-6">
      <p set:html={content.tag} class="subtitle-lg text-primary"></p>
      <h2 set:html={content.title} class="heading-h4"></h2>
    </div>
    <p set:html={content.description} class="book-description body-md"></p>
    <div class="book-card animation-image-reveal-trigger w-full relative h-auto rounded-2xl " style="aspect-ratio: 628 / 413;">
      <div class="book-image animation-image-reveal animation-image-reveal--left-to-right w-full h-full relative rounded-2xl overflow-hidden">
        <video class="book-video absolute inset-0 w-full h-full object-cover object-center" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1">
          <source data-src="https://pub-9825dca4a1fb47b09d6ba9861c502df4.r2.dev/video_main_2.mp4" type="video/mp4">
        </video>
      </div>
    </div>
  </div>
  <div class="book-panel w-full md:w-1/2 h-auto fade-up-a  rounded-2xl bg-white px-6 py-8">
    <FormContact />
  </div>
</div>

<script>
  import { prepareImageReveal } from "../../scripts/imageReveal";
  const initBookSequences = () => {
    document.querySelectorAll<HTMLElement>(".book-sequence").forEach((book) => {
      const heading = book.querySelector<HTMLElement>(".book-heading");
      const panel = book.querySelector<HTMLElement>(".book-panel");
      const description = book.querySelector<HTMLElement>(".book-description");
      const card = book.querySelector<HTMLElement>(".book-card");

      const image = book.querySelector<HTMLElement>(".book-image");
      const revealImage = image ? prepareImageReveal(image) : () => {};
      const video = book.querySelector<HTMLVideoElement>(".book-video");
      const source = video?.querySelector<HTMLSourceElement>("source[data-src]");
      let videoVisible = false;

      const updateVideo = () => {
        if (!video || !source) return;
        if (videoVisible && !document.hidden && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          if (!source.src && source.dataset.src) {
            source.src = source.dataset.src;
            video.load();
          }
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      };

      if (video && "IntersectionObserver" in window) {
        const videoObserver = new IntersectionObserver(([entry]) => {
          videoVisible = Boolean(entry?.isIntersecting);
          updateVideo();
        }, { rootMargin: "200px 0px", threshold: 0 });
        videoObserver.observe(video);
      } else {
        videoVisible = true;
        updateVideo();
      }

      document.addEventListener("visibilitychange", updateVideo);

      const groups = [
        { target: heading, delay: 0, reveal: () => heading?.querySelectorAll("p, h2").forEach((element) => element.classList.add("active")) },
        { target: panel, delay: 0, reveal: () => panel?.classList.add("active") },
        { target: description, delay: 500, reveal: () => description?.classList.add("active") },
        { target: card, delay: 1000, reveal: revealImage },
      ];

      if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        groups.forEach((group) => group.reveal());
        return;
      }

      let start: number | undefined;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const group = groups.find((item) => item.target === entry.target);
          if (!group) return;
          observer.unobserve(entry.target);
          start ??= performance.now();
          const remaining = Math.max(0, start + group.delay - performance.now());
          if (remaining) window.setTimeout(group.reveal, remaining);
          else group.reveal();
        });
      }, { threshold: 0.3 });
      groups.forEach((group) => { if (group.target) observer.observe(group.target); });
    });
  };

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initBookSequences, { once: true });
  else initBookSequences();
</script>
