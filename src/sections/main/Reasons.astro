---
type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["reasons"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="reasons-section relative w-full bg-primary ">
  <div class="reasons-inner container-full relative mx-auto">
    <nav class="reasons-index" aria-label="System stages">
      <span class="reasons-index-track" aria-hidden="true"><span class="reasons-index-fill"></span></span>
      <ol>{content.indicators.map((label) => <li class="reasons-index-item subtitle-sm">{label}</li>)}</ol>
    </nav>
    <div class="reasons-slides">
  {
    content.items.map((item,index)=>(
      <div class="reasons-slide flex justify-end items-center gap-14 h-full md:h-auto xl:[@media(height_<_810px)]:h-screen py-12 md:py-20 xl:[@media(height_<_810px)]:py-0">
        <div class="flex flex-col justify-center items-start gap-8 md:gap-10 max-w-[520px]">
          <h2 set:html={item.title} class="heading-h4 text-paragraph mb-0 md:mb-3 lg:mb-0"></h2>
          {
            item.description !== "" && <p set:html={item.description} class="body-md text-paragraph"></p>
          }
          
          <ul class="flex flex-col justify-center items-start gap-6">
            {
              item.list.map((listItem,index)=>(
                <li class="flex justify-center items-center gap-2 fade-up-a" style={{ "--fade-up-delay": `${index * 100}ms` }}>
                  <img src="/images/icons/check.svg" alt="Check" width="24" height="24" class='w-5 h-5' decoding="async" loading="lazy" />
                  <span class='body-md text-paragraph'>{listItem}</span>
                </li>
              ))
            }
          </ul>
          <div class="w-[51px] h-1 bg-secondary fade-up-a"></div>
          <ul class='flex flex-col  justify-center items-start gap-6'>
            {
              item.list1.map((listItem,i)=>(
                <li class="flex justify-center items-center gap-1.25 fade-up-a" style={{ "--fade-up-delay": `${i * 100}ms` }}>
                  <img src={`/images/icons/reasons${index+1}-${i+1}.svg`} alt="Check" width="24" height="24" class='w-5 h-5' decoding="async" loading="lazy" />
                  <span class='body-md text-paragraph'>{listItem.description}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="animation-image-reveal-trigger w-[38%] xl:[@media(height_<_810px)]:w-[35%] shrink-0 hidden md:block">
          <div class="animation-image-reveal w-full h-auto relative overflow-hidden rounded-2xl aspect-43/68">
            <div class="animation-image-reveal-mask w-full h-full overflow-hidden rounded-2xl">
              <img src={`/images/steps-${index + 1}.webp`} alt={`Step ${index + 1}`} width="941" height="1672" class="w-full h-full object-cover object-center" decoding="async" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    ))
  }
    </div>
  </div>
</section>
<style>
  .reasons-index { position: absolute; top: 50%; left: 0; transform: translateY(-50%); z-index: 1; }
  .reasons-index ol { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1rem; }
  .reasons-index-item { color: var(--color-paragraph); font-size: 0.875rem; }
  .reasons-index-item.is-active { color: var(--color-secondary); opacity: 1; }
  .reasons-index-track { position: absolute; left: 0; top: 0; width: 2px; height: 100%;  }
  .reasons-index-fill { display: block; width: 100%; height: 100%; background: var(--color-secondary); transform: scaleY(0.3333); transform-origin: top left; }
  .reasons-slides { display: flex; flex-direction: column; gap: 5rem; padding-left: 12rem; }
  .reasons-section.is-pinned { min-height: 100svh; display: flex; align-items: center; }
  .reasons-section.is-pinned .reasons-slides { display: grid; }
  .reasons-section.is-pinned .reasons-slide { grid-area: 1 / 1; }
  @media (min-width: 768px) and (max-width: 1023px) {
    .reasons-section.is-pinned { padding-block: 24px; }
    .reasons-section.is-pinned .reasons-index { position: relative; top: auto; transform: none; margin-bottom: 1.5rem; }
    .reasons-section.is-pinned .reasons-slides { padding-left: 0; }
    .reasons-section.is-pinned .reasons-slide { gap: 1.5rem; }
    .reasons-section.is-pinned .reasons-slide > div:first-child { gap: 1rem; }
    .reasons-section.is-pinned .animation-image-reveal-trigger { width: min(38%, calc((100svh - 200px) * 43 / 68)); }
  }
  @media (max-width: 767px) {
    .reasons-index { position: relative; top: auto; transform: none; margin-bottom: 3rem; }
    .reasons-slides { padding-left: 0; }
    .reasons-slide { flex-direction: column; align-items: stretch; gap: 2rem; }
    .reasons-slide > div { width: 100%; max-width: none; }
  }
</style>

<script>
  import { bindScrollSteps } from "../../scripts/scrollSteps";
  import { gsap, ScrollTrigger } from "../../scripts/gsap";

  document.querySelectorAll<HTMLElement>(".reasons-section").forEach((section) => {
    const slides = gsap.utils.toArray<HTMLElement>(section.querySelectorAll(".reasons-slide"));
    const items = gsap.utils.toArray<HTMLElement>(section.querySelectorAll(".reasons-index-item"));
    const fill = section.querySelector<HTMLElement>(".reasons-index-fill");
    if (!slides.length || !fill) return;

    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      // Keep the normal document flow when the content cannot fit on screen.
      section.classList.add("is-pinned");
      if (section.scrollHeight > window.innerHeight) {
        section.classList.remove("is-pinned");
        if (window.innerWidth >= 1024) return;

        // On short screens, keep every slide readable in the normal flow.
        const setActiveSlide = (index: number) => {
          items.forEach((item, itemIndex) => item.classList.toggle("is-active", itemIndex === index));
          gsap.set(fill, { scaleY: (index + 1) / slides.length });
        };
        const triggers = slides.map((slide, index) => ScrollTrigger.create({
          trigger: slide,
          start: "top center",
          end: "bottom center",
          onEnter: () => setActiveSlide(index),
          onEnterBack: () => setActiveSlide(index),
        }));
        setActiveSlide(0);
        ScrollTrigger.refresh();
        return () => {
          triggers.forEach((trigger) => trigger.kill());
          items.forEach((item) => item.classList.remove("is-active"));
          gsap.set(fill, { clearProps: "transform" });
        };
      }

      gsap.set(slides[0], { autoAlpha: 1 });
      gsap.set(slides.slice(1), { autoAlpha: 0 });
      gsap.set(fill, { scaleY: 1 / slides.length });
      items[0]?.classList.add("is-active");
      let revealedIndex = -1;
      let pendingFirstReveal = false;
      let disposed = false;
      const transitionObserver = new MutationObserver(() => {
        if (pendingFirstReveal && !document.documentElement.classList.contains("section-transitioning")) {
          pendingFirstReveal = false;
          if (!disposed) revealSlide(0);
        }
      });
      transitionObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
      const revealFirstSlide = () => {
        if (disposed) return;
        if (document.documentElement.classList.contains("section-transitioning")) {
          pendingFirstReveal = true;
        } else {
          revealSlide(0);
        }
      };
      const revealSlide = (index: number) => {
        pendingFirstReveal = false;
        if (index === revealedIndex) {
          slides[index].querySelectorAll("h1, h2, h3, h4, h5, p, .fade-up-a, .animation-image-reveal")
            .forEach(element => element.classList.add("active"));
          return;
        }
        const previousIndex = revealedIndex;
        revealedIndex = index;
        slides.forEach((slide, slideIndex) => {
          if (slideIndex === previousIndex) return;
          slide.querySelectorAll("h1, h2, h3, h4, h5, p, .fade-up-a, .animation-image-reveal")
            .forEach((element) => element.classList.remove("active"));
        });
        // Reset the incoming slide before replaying its CSS transitions.
        requestAnimationFrame(() => requestAnimationFrame(() => {
          if (revealedIndex !== index) return;
          slides[index].querySelectorAll("h1, h2, h3, h4, h5, p, .fade-up-a, .animation-image-reveal")
            .forEach((element) => element.classList.add("active"));
        }));
      };
      slides.forEach((slide) => {
        slide.querySelectorAll("h1, h2, h3, h4, h5, p, .fade-up-a, .animation-image-reveal").forEach((element) => element.classList.remove("active"));
        slide.querySelector(".animation-image-reveal")?.classList.add("reveal-ready");
      });
      const timeline = gsap.timeline({
        onUpdate(this: gsap.core.Animation) {
          const activeIndex = Math.min(slides.length - 1, Math.floor((this.time() + 0.225) / 0.5));
          items.forEach((item, index) => item.classList.toggle("is-active", index === activeIndex));
          if (this.scrollTrigger?.isActive) {
            if (activeIndex === 0) revealFirstSlide();
            else revealSlide(activeIndex);
          }
        },
        scrollTrigger: {
          trigger: section,
          refreshPriority: -1,
          start: "top top",
          end: () => `+=${window.innerHeight * (slides.length - 1 + 0.7) * 0.9}`,
          pin: true,
          anticipatePin: 1,
          pinSpacing: true,
          scrub: true,
          onEnter: () => {
            revealFirstSlide();
          },
          onEnterBack: () => revealSlide(slides.length - 1),
          onRefresh: self => {
            if (self.isActive) {
              const index = Math.min(slides.length - 1, Math.floor(((self.animation?.time() ?? 0) + 0.225) / 0.5));
              if (index === 0) revealFirstSlide();
              else revealSlide(index);
            }
          },
          invalidateOnRefresh: true,
        },
      });

      slides.slice(1).forEach((slide, index) => {
        const at = 0.5 * index + 0.2;
        // Finish hiding the outgoing slide before revealing the next one.
        // A wheel stop must never leave two readable slides stacked together.
        timeline.fromTo(slides[index], { autoAlpha: 1 }, { autoAlpha: 0, duration: 0.1, ease: "power1.in", immediateRender: false }, at)
          .fromTo(slide, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.15, ease: "power1.out", immediateRender: false }, at + 0.1);
      });
      timeline.to(fill, { scaleY: 1, ease: "none", duration: timeline.duration() }, 0)
        .to({}, { duration: 0.5 });

      const firstSlideObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting) && revealedIndex === -1) {
          revealFirstSlide();
          firstSlideObserver.disconnect();
        }
      }, { rootMargin: "0px 0px -30% 0px", threshold: 0 });
      firstSlideObserver.observe(section);



      // Earlier pinned sections must be measured before this section.
      const stopScrollSteps = bindScrollSteps(timeline, [0, ...slides.slice(1).map((_, index) => (0.5 * index + 0.5) / (0.5 * (slides.length - 2) + 0.95)), 1]);
      ScrollTrigger.sort();
      ScrollTrigger.refresh();

      return () => {
        stopScrollSteps();
        disposed = true;
        transitionObserver.disconnect();
        firstSlideObserver.disconnect();
        section.classList.remove("is-pinned");
        items.forEach((item) => item.classList.remove("is-active"));
        slides.forEach((slide) => {
          slide.querySelectorAll("h1, h2, h3, h4, h5, p, .fade-up-a, .animation-image-reveal").forEach((element) => element.classList.add("active"));
        });
      };
    });

    // Re-evaluate whether the section fits after viewport resizing.
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => gsap.matchMediaRefresh(), 150);
    });
  });
</script>
