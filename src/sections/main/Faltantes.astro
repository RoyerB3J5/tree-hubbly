---
type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["system"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section id="faltantes" data-reveal-sequence class="w-full flex justify-center items-center bg-primary-2 ">
  <div class="w-full flex flex-col justify-center items-center p-4 md:p-8 overflow-hidden max-w-[1536px] min-h-screen md:min-h-0 h-auto xl:h-screen">
    <div class="w-full flex-1 flex flex-col justify-between items-start md:items-center back-main-2 gap-8 md:gap-10 py-[74px] xl:[@media(height_<_810px)]:gap-4 xl:[@media(height_<_810px)]:justify-center rounded-2xl px-4 md:px-12 xl:[@media(height_<_810px)]:py-0">
      <h2 set:html={content.title} class='heading-h4 text-paragraph text-start md:text-center'></h2>
    <div class='faltantes-items w-full md:flex justify-center items-center gap-10 xl:gap-40 py-6 border-y border-white/10 hidden'>
      {
        content.items.map((item)=>(
          <div class="flex justify-center items-center gap-[5px] fade-up-a ">
            <img src={`/images/icons/${item.icon}.svg`} alt={item.title} width="24" height="24" class='w-5 h-5 ' decoding="async" loading="lazy"/>
            <span class="subtitle-lg text-paragraph">{item.title}</span>
          </div>
        ))
      }
    </div>
    <div class="flex w-full flex-col lg:flex-row justify-center items-center gap-8 md:gap-6">
        <div class="faltantes-details w-full lg:w-1/2 flex flex-col justify-center items-start gap-8 text-paragraph">
          <p class="faltantes-description fade-up-a body-md">{content.description}</p>
          <ul class="faltantes-list fade-up-a flex flex-col justify-center items-start gap-4 xl:gap-6 w-full">
            {
              content.list.map((l)=>(
                <li class="flex justify-start items-center gap-2">
                  <img src="/images/icons/check.svg" alt="Check" width="24" height="24" class="w-5 md:w-6 h-5 md:h-6 ">
                  <span class="text-paragraph body-md">{l}</span>
                </li>
              ))
            }
          </ul>
          <div class="faltantes-tag fade-up-a w-full flex justify-center items-center px-4 py-8 rounded-2xl border border-[#263A4B]">
            <span set:html={content.tag} class="body-lg text-paragraph text-center"></span>
          </div>
        </div>
        <div class="animation-image-reveal-trigger w-full lg:w-1/2">
          <div class="w-full relative rounded-lg lg:rounded-2xl [--image-reveal-radius:0.5rem] lg:[--image-reveal-radius:1rem] aspect-366/375 md:aspect-628/375 lg:aspect-628/575 xl:aspect-628/375 h-auto overflow-hidden animation-image-reveal">
            <div class="animation-image-reveal-mask w-full h-full overflow-hidden rounded-lg lg:rounded-2xl">
              <img src="/images/faltantes.webp" alt="Companies TreeHubly" width="1536" height="1024" class="w-full h-full object-cover object-center" decoding="async" loading="lazy"/>
            </div>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</section>

<script>
  const section = document.getElementById("faltantes");
  if (section) {
    const init = () => {
      const targets = Array.from(section.querySelectorAll<HTMLElement>("h2, p, .fade-up-a, .animation-image-reveal"));
      const reveal = () => {
        targets.forEach((element, index) => {
          element.style.setProperty("--fade-up-delay", `${Math.min(index, 5) * 0.12}s`);
          element.style.setProperty("--fade-up-lines-delay", `${Math.min(index, 5) * 0.12}s`);
          if (element.classList.contains("animation-image-reveal")) element.classList.add("reveal-ready");
        });
        requestAnimationFrame(() => requestAnimationFrame(() => {
          targets.forEach(element => element.classList.add("active"));
        }));
      };
      if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        reveal();
        return;
      }
      const observer = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting && entry.intersectionRatio >= 0.2)) return;
        observer.disconnect();
        reveal();
      }, { threshold: 0.2 });
      observer.observe(section);
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init, { once: true });
    else init();
  }
</script>
