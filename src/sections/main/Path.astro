---
type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["path"];
interface Props { content: Content; }
const { content } = Astro.props as Props;
---
<section class="path-section flex min-h-svh w-full items-center justify-center bg-white">
  <div class="path-layout container-full flex flex-col items-start justify-between gap-10 md:gap-12  py-10 md:py-20 xl:[@media(height_<_810px)]:py-6 min-[728px]:flex-row">
    <div class="path-intro flex flex-col justify-center items-start gap-6 text-primary">
      <p class="subtitle-lg">{content.tag}</p>
      <h2 set:html={content.title} class="heading-h4"></h2>
    </div>
    <div class="path-list relative w-full max-w-[440px] shrink-0 self-end min-[728px]:w-[440px] min-[728px]:self-auto lg:w-[52%] lg:max-w-none xl:w-[440px] xl:max-w-[440px]">
      <div class="path-rail absolute top-0 bottom-0 left-[76px] w-px max-md:w-[2px] bg-[#b2b7bb] max-[481px]:left-[49px]" aria-hidden="true"><div class="path-progress h-0 w-full bg-primary"></div></div>
      <img class="path-marker absolute top-0 right-[calc(100%+32px)] z-2 hidden h-auto w-[120px] -translate-y-1/2" src="/images/index-steps.png" alt="" aria-hidden="true" />
      {content.structure.map((item, index) => (
        <div class="path-item relative grid grid-cols-[36px_8px_minmax(0,304px)] lg:grid-cols-[36px_8px_minmax(0,1fr)] xl:grid-cols-[36px_8px_minmax(0,304px)] items-start gap-x-9 pb-16 xl:[@media(height_<_810px)]:pb-8 text-primary last:pb-0 max-[481px]:grid-cols-[26px_8px_minmax(0,1fr)] max-[481px]:gap-x-5">
          <div class="path-number body-md pt-2.5">0{index + 1}</div>
          <div class="path-dot relative z-1 mt-3.5 size-2 rounded-full bg-primary" aria-hidden="true"></div>
          <div class="path-copy">
            <h3 class="path-title heading-h4">{item.title}</h3>
            <div class="path-details">
              <div class="path-details-inner flex flex-col items-start gap-6 pt-6">
                <p class="subtitle-lg">{item.tag}</p>
                <p class="body-md">{item.description}</p>
                <img src={`/images/icons/${item.icon}.svg`} alt="" width="66" height="77" class="h-[77px] w-[66px] flex-none object-contain object-left" decoding="async" loading="lazy" />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .path-scroll-controlled { height: 100svh; }
  @media (min-width: 1280px) {
    .path-scroll-controlled .path-marker { display: block; }
  }
  .path-scroll-controlled .path-details { overflow: hidden; }
  @media (max-width: 727px) {
    .path-copy :global(.fade-up-line-fragment) {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { bindScrollSteps } from "../../scripts/scrollSteps";
  import { gsap, ScrollTrigger } from "../../scripts/gsap";

  const section = document.querySelector<HTMLElement>(".path-section");
  if (section) {
    const items = gsap.utils.toArray<HTMLElement>(section.querySelectorAll(".path-item"));
    const list = section.querySelector<HTMLElement>(".path-list");
    const marker = section.querySelector<HTMLElement>(".path-marker");
    const progress = section.querySelector<HTMLElement>(".path-progress");
    const media = gsap.matchMedia();

    const animateProgressInFlow = () => {
      if (!list || !progress || !items.length) return () => {};
      const firstDot = items[0].querySelector<HTMLElement>(".path-dot");
      const lastDot = items[items.length - 1].querySelector<HTMLElement>(".path-dot");
      if (!firstDot || !lastDot) return () => {};
      let frame = 0;
      let disposed = false;
      const update = () => {
        frame = 0;
        const first = firstDot.getBoundingClientRect();
        const last = lastDot.getBoundingClientRect();
        const start = first.top + first.height / 2;
        const end = last.top + last.height / 2;
        const distance = end - start;
        const fraction = distance > 0 ? gsap.utils.clamp(0, 1, (window.innerHeight * 0.75 - start) / distance) : 1;
        progress.style.height = `${fraction * 100}%`;
      };
      const scheduleUpdate = () => {
        if (!frame && !disposed) frame = requestAnimationFrame(update);
      };
      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate);
      document.fonts.ready.then(scheduleUpdate);
      scheduleUpdate();
      return () => {
        disposed = true;
        cancelAnimationFrame(frame);
        window.removeEventListener("scroll", scheduleUpdate);
        window.removeEventListener("resize", scheduleUpdate);
        progress.style.removeProperty("height");
      };
    };

    media.add("(prefers-reduced-motion: reduce)", animateProgressInFlow);

    media.add("(max-width: 727px) and (prefers-reduced-motion: no-preference)", () => {
      if (!list || !progress || !items.length) return;
      const animated = items.flatMap((item) => {
        const number = item.querySelector<HTMLElement>(".path-number");
        const copy = item.querySelector<HTMLElement>(".path-copy");
        number?.classList.add("fade-right-a");
        copy?.classList.add("fade-left-a");
        return [number, copy].filter((element): element is HTMLElement => Boolean(element));
      });
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("active");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.3 });
      animated.forEach((element) => observer.observe(element));

      const stopProgress = animateProgressInFlow();
      return () => {
        observer.disconnect();
        stopProgress();
        animated.forEach((element) => element.classList.remove("fade-right-a", "fade-left-a", "active"));
      };
    });

    media.add("(min-width: 728px) and (prefers-reduced-motion: no-preference)", () => {
      if (!list || !marker || !progress || items.length < 2) return;
      const details = items.map(item => item.querySelector<HTMLElement>(".path-details")!);
      const dots = items.map(item => item.querySelector<HTMLElement>(".path-dot")!);
      const targets = items.map(item => item.querySelectorAll<HTMLElement>(".path-title, .path-number, .path-dot"));
      // Measure the inner content even when its animated wrapper is collapsed.
      const detailHeight = () => Math.max(...details.map(detail =>
        detail.querySelector<HTMLElement>(".path-details-inner")!.scrollHeight
      ));
      section.classList.add("path-scroll-controlled");
      gsap.set(details[0], { height: detailHeight() });
      gsap.set(details.slice(1), { height: 0, autoAlpha: 0 });
      gsap.set(targets.slice(1).flatMap(group => Array.from(group)), { color: "#B2B7BB" });
      gsap.set(dots.slice(1), { backgroundColor: "#B2B7BB" });

      // Keep the full content available when the pinned layout cannot fit the viewport.
      if (section.scrollHeight > window.innerHeight + 1) {
        section.classList.remove("path-scroll-controlled");
        gsap.set([...details, ...targets.flatMap(group => Array.from(group))], { clearProps: "all" });
        return animateProgressInFlow();
      }

      const updateIndicator = (value: number) => {
        const position = value * (items.length - 1);
        const from = Math.min(Math.floor(position), items.length - 2);
        const fraction = position - from;
        const dotY = (dot: HTMLElement) => dot.getBoundingClientRect().top - list.getBoundingClientRect().top + dot.offsetHeight / 2;
        const y = gsap.utils.interpolate(dotY(dots[from]), dotY(dots[from + 1]), fraction);
        gsap.set(marker, { top: y });
        gsap.set(progress, { height: y });
      };

      const timeline = gsap.timeline({ scrollTrigger: {
        trigger: section, start: "top top", end: () => `+=${window.innerHeight * (items.length - 1 + 0.7) * 0.9}`,
        pin: true, pinSpacing: true, scrub: true, refreshPriority: -3, invalidateOnRefresh: true, anticipatePin: 1,
        onUpdate: self => updateIndicator(Math.min(1, self.progress * (items.length - 1 + 0.35) / (items.length - 1))),
        onRefresh: self => updateIndicator(Math.min(1, self.progress * (items.length - 1 + 0.35) / (items.length - 1))),
      }});
      for (let i = 0; i < items.length - 1; i++) {
        timeline.to(details[i], { height: 0, autoAlpha: 0, duration: 0.5, ease: "none" }, i * 0.5)
          .to(targets[i], { color: "#B2B7BB", duration: 0.5, ease: "none" }, i * 0.5)
          .to(dots[i], { backgroundColor: "#B2B7BB", duration: 0.5, ease: "none" }, i * 0.5)
          .to(details[i + 1], { height: () => detailHeight(), autoAlpha: 1, duration: 0.5, ease: "none" }, i * 0.5)
          .to(targets[i + 1], { color: "#051725", duration: 0.5, ease: "none" }, i * 0.5)
          .to(dots[i + 1], { backgroundColor: "#051725", duration: 0.5, ease: "none" }, i * 0.5);
      }
      // Keep the final step visible during the last part of the scroll.
      timeline.to({}, { duration: 0.175 });
      updateIndicator(0);

      const stopScrollSteps = bindScrollSteps(timeline, [...items.map((_, index) => index / (items.length - 1 + 0.35)), 1]);
      ScrollTrigger.sort();
      ScrollTrigger.refresh();
      // Text wrapping and font loading can change the content height after setup.
      let measureFrame = 0;
      let disposed = false;
      const updateMeasurements = () => {
        cancelAnimationFrame(measureFrame);
        measureFrame = requestAnimationFrame(() => {
          if (disposed || !timeline.scrollTrigger) return;
          if (timeline.scrollTrigger.progress === 0) gsap.set(details[0], { height: detailHeight() });
          ScrollTrigger.refresh();
        });
      };
      const sizeObserver = new ResizeObserver(updateMeasurements);
      details.forEach((detail) => sizeObserver.observe(detail.querySelector<HTMLElement>(".path-details-inner")!));
      document.fonts.ready.then(updateMeasurements);
      return () => {
        stopScrollSteps();
        disposed = true;
        cancelAnimationFrame(measureFrame);
        sizeObserver.disconnect();
        section.classList.remove("path-scroll-controlled");
        gsap.set([...details, ...targets.flatMap(group => Array.from(group)), marker, progress], { clearProps: "all" });
      };
    });
  }
</script>



