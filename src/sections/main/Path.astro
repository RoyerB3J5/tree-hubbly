---
type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["path"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="path-section w-full bg-white flex justify-center items-center">
  <div class="container-full flex justify-between items-start py-20">
    <div class="flex flex-col justify-center items-start gap-6 text-primary">
      <p class="subtitle-lg">{content.tag}</p>
      <h2 set:html={content.title} class='heading-h4'></h2>
    </div>
    <div class="flex flex-col justify-center items-end gap-[50px] relative ">
      <div class="w-[1px] h-full bg-primary absolute top-0 left-15"></div>
      {
        content.structure.map((item,index)=>(
          <div class='flex justify-center items-start gap-10 '>
            <div class='flex justify-center items-center gap-9 mt-2'>
              <p class='body-md text-primary'>0{index + 1}</p>
              <div class='w-2 h-2 bg-primary rounded-full'></div>
            </div>
            <div class="flex flex-col justify-center items-start gap-8 text-primary max-w-[304px] w-full">
              <h3 class="heading-h4">{item.title}</h3>
              <p class="subtitle-lg">{item.tag}</p>
              <p class="body-md">{item.description}</p>
              <img src={`/images/icons/${item.icon}.svg`} alt={item.title} width="66" height="77" class='w-[30%] h-auto' decoding="async" loading="lazy"/>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>