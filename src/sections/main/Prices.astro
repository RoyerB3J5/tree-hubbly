---
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["ecosystem"] | Translations["plans"]["complete"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class='w-full flex justify-center items-center bg-primary text-paragraph'>
  <div class={`container-full flex flex-col justify-center items-center gap-8 md:gap-10  ${'plan' in content ? "pt-26 md:pt-40 pb-12 md:pb-20" : "py-12 md:py-20"}`}>
    <div class='flex flex-col justify-center items-start md:items-center gap-6 '>
      <p class='subtitle-lg' set:html={content.tag}></p>
      <h2 set:html={content.title} class='heading-h4 text-start md:text-center'></h2>
    </div>
      <div class:list={['prices-grid w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-center items-stretch', { 'prices-grid-complete': 'plan' in content }]}>
      {
        content.service.map((item,index)=>(
          <div data-reveal-sequence class={`price-card w-full flex flex-col justify-start items-start gap-8 py-6 md:py-10 px-4 md:px-6 rounded-2xl border fade-up-a  ${index === 1 ? "back-prices border-secondary" : "bg-transparent border-[#263A4B]"}`}>
            <div class="w-full flex justify-between items-center h-[27.8px]">
              <p class='subtitle-sm uppercase'>{item.tag}</p>
              {
                item.tag2 !== "" && (<div class={`flex justify-center items-center py-2 px-3 border border-secondary rounded-full ${index === 1 ? "bg-secondary text-primary" : "bg-transparent "}`}>
                <p class="uppercase subtitle-sm">{item.tag2}</p>
              </div>)
              }
              
            </div>
            <h3 class='heading-h5 text-start'>{item.title}</h3>
            <p class="body-md text-start" set:html={item.description}></p>
            <div class="flex flex-col justify-start items-start gap-6 ">
              {
                item.lists.map((listItem,index)=>(
                  <div class="flex justify-start items-center gap-2 fade-up-a " style={`--fade-up-delay: ${index * 0.1}s`}>
                    <img src="/images/icons/check.svg" alt="Check" width="24" height="24" class="w-5 h-5 " decoding="async" loading="lazy" />
                    <div class='flex flex-col justify-center items-start gap-3'>
                      <span class="text-paragraph body-md">{listItem.title}</span>
                      {
                        listItem.description !== "" && (<span class="text-[#8F979D] body-sm">{listItem.description}</span>)
                      }
                    </div>
                  </div>
                ))
              }
            </div>
            
            <div class="w-full flex flex-col justify-start items-center gap-4 ">
              <Button
                  text={item.button[0].label}
                  href={item.button[0].href}
                  extraBtnClass={`${index === 1 ? "bg-secondary border-secondary" : "bg-transparent border-paragraph"} w-full fade-up-a`}
                  textClass={`${index === 1 ? "text-primary" : "text-paragraph"} `}
                />
              <p class='body-sm text-[#8F979D] text-center'>{item.subtag}</p>
            </div>

            {
              'steps' in item && (
                <div class='w-full h-[1px] bg-[#263A4B]'></div>
              )
            }

            {'steps' in item && (
              <div class="flex flex-col gap-8 w-full mt-8">
                  {item.steps.map((step,i) => (
                    <div class='flex justify-start items-start gap-2'>
                      <div class={`w-6 h-6  ${index === 1 ? "bg-black/25" : "bg-white/10"} rounded-[4px] flex justify-center items-center shrink-0`}>
                        <p class='subtitle-sm'>{i+1}</p>
                      </div>
                      <div class="flex flex-col gap-3 justify-center items-start">
                        <h4 class="subtitle-lg text-paragraph">{step.title}</h4>
                        <p class="body-sm text-[#8F979D]">{step.description}</p>
                      </div>
                    </div>
                  ))}
                </div>
            )}
          </div>
        ))
      }
    </div>
    {'plan' in content && (
      <div class="w-full flex flex-col lg:flex-row justify-center lg:justify-between items-start lg:items-center gap-6 rounded-2xl border border-[#263A4B] py-10 px-4 md:p-10 back-main-4 fade-up-a">
        <div class='flex flex-col lg:flex-row justify-center items-start lg:items-center gap-6 md:gap-8'>
          <img src="/images/icons/film.svg" alt="Film" width="101" height="101" decoding="async" loading="lazy" class='fade-up-a w-[50px] h-[50px] md:w-[101px] md:h-[101px]' />
          <div class="flex flex-col justify-center items-start gap-6 text-paragraph">
            <h3 class="body-lg" set:html={content.plan.title}></h3>
            <p class="body-md" set:html={content.plan.description}></p>
            <ul class="flex flex-wrap justify-start lg:justify-center gap-4 fade-up-a">
              {content.plan.options.map((option) => <li class=" border border-secondary px-3 py-2 rounded-full flex justify-center items-center fade-up-a"><span class='subtitle-sm'>{option.title}</span></li>)}
            </ul>
          </div>
        </div>
        <Button text={content.plan.button[0].label} href={content.plan.button[0].href} extraBtnClass="bg-secondary border-secondary text-center" textClass="text-primary" />
      </div>
    )}
  </div>
</section>

<style>
  @media (min-width: 64rem) {
    .prices-grid {
      grid-template-rows: repeat(5, auto);
      row-gap: 2rem;
    }

    .price-card {
      display: grid;
      grid-row: span 5;
      grid-template-rows: subgrid;
      row-gap: 2rem;
      column-gap: 0;
      align-items: stretch;
    }

    .prices-grid-complete {
      grid-template-rows: repeat(6, auto);
    }

    .prices-grid-complete .price-card {
      grid-row: span 6;
    }
  }
</style>

<script>
  const initPrices = () => queueMicrotask(() => {
    document.querySelectorAll<HTMLElement>(".prices-grid").forEach(grid => {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>(".price-card"));
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduced || !("IntersectionObserver" in window)) {
        cards.forEach(card => {
          card.classList.add("active");
          card.querySelectorAll(".fade-up-a, .fade-up-lines-raw").forEach(child => child.classList.add("active"));
        });
        return;
      }
      let queue = Promise.resolve();
      const waitForEntrance = (elements: HTMLElement[]) => new Promise<void>(resolve => {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          const animations = elements.flatMap(element => element.getAnimations({ subtree: true }))
            .filter(animation => animation.effect?.getComputedTiming().iterations !== Infinity);
          Promise.allSettled(animations.map(animation => animation.finished)).then(() => resolve());
        }));
      });
      const revealCard = async (card: HTMLElement) => {
        card.classList.add("active");
        await waitForEntrance([card]);
        const children = Array.from(card.querySelectorAll<HTMLElement>(".fade-up-a, .fade-up-lines-raw"));
        // Keep observing lower content as the user scrolls down the long card.
        let firstBatch = true;
        await new Promise<void>(resolve => {
          const contentObserver = new IntersectionObserver(entries => {
            const visible = entries.filter(entry => entry.isIntersecting && entry.intersectionRatio >= 0.3);
            visible.forEach(entry => {
              entry.target.classList.add("active");
              contentObserver.unobserve(entry.target);
            });
            if (firstBatch) {
              firstBatch = false;
              waitForEntrance(visible.map(entry => entry.target as HTMLElement)).then(resolve);
            }
          }, { threshold: 0.3 });
          if (!children.length) resolve();
          children.forEach(child => contentObserver.observe(child));
        });
      };
      const cardObserver = new IntersectionObserver(entries => {
        entries.filter(entry => entry.isIntersecting && entry.intersectionRatio >= 0.3)
          .sort((a, b) => cards.indexOf(a.target as HTMLElement) - cards.indexOf(b.target as HTMLElement))
          .forEach(entry => {
            cardObserver.unobserve(entry.target);
            queue = queue.then(() => revealCard(entry.target as HTMLElement));
          });
      }, { threshold: 0.3 });
      cards.forEach(card => cardObserver.observe(card));
    });
  });
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initPrices, { once: true });
  else initPrices();
</script>
