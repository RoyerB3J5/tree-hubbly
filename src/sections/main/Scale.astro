---
type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["grow"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="home-scale w-full flex justify-center items-center relative h-auto md:h-[40dvh] lg:h-[80dvh] bg-white">
  {/*<img src="/images/bg-scale.webp" alt="Where Tree Companies Scale" width="2100" height="1172" class="w-full h-full object-cover object-center -z-20 absolute"> */}
  
  <div class="absolute w-full h-full inset-0 -z-10 back-main-3"></div>
  <div class=" container-full py-20 flex justify-start items-end gap-6 h-full">
    <div class="flex jusitfy-center items-center gap-6">
      <img src="/images/icons/hoja.svg" alt="Tree Company Logo" width="38" height="56" class="w-[38px] h-auto fade-up-a" decoding="async" loading="lazy"/>
    <h3 set:html={content.title} class="heading-h4 text-paragraph"></h3>
    </div>
    
  </div>
</section>
