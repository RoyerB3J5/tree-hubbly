---
type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["control"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class='control-section w-full flex justify-center items-center bg-third-light '>
  <div class='container-full flex flex-col justify-between items-center py-12 md:py-20 gap-8 md:gap-10 h-auto xl:h-[100svh]'>
    <div class="w-full flex flex-col md:flex-row justify-center md:justify-between items-start md:items-center gap-8 md:gap-0">
      <div class='flex flex-col justify-center items-start gap-6 text-primary max-w-[411px]'>
        <p class="subtitle-lg">{content.tag}</p>
        <h2 set:html={content.title} class='heading-h4'></h2>
        {
          content.description !== "" && (<p class="body-md">{content.description}</p>)
        }
        
      </div>
      <div class='animation-image-reveal-trigger w-full md:w-[55%]'>
        <div class='animation-image-reveal w-full h-auto relative overflow-hidden rounded-2xl aspect-398/240 md:aspect-737/411'>
          <div class='animation-image-reveal-mask w-full h-full overflow-hidden rounded-2xl'>
            <img src={`/images/${content.img}.webp`} alt="Control" width="1400" height="788" class="w-full h-full object-cover object-center" decoding="async" loading="lazy"/>
          </div>
        </div>
      </div>
    </div>
    <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 justify-center items-stretch">
      {
        content.measuring.map((item)=>( 
          <div class="control-item w-full flex flex-col justify-center items-start gap-4 md:gap-6 bg-white px-4 py-8 md:p-6 rounded-2xl">
            <p class="body-md order-2 md:order-1">{item.tag}</p>
            <h3 class='body-lg grow order-3 md:order-2'>{item.description}</h3>
            <div class={`control-item-icon fade-left-a w-12 h-12 rounde-lg flex justify-center items-center rounded-lg bg-third-light self-end order-1 md:order-3`}>
                <img src={`/images/icons/${item.icon}.svg`} alt={item.description} width="20" height="20" class='w-5 h-5' decoding="async" loading="lazy"/>
              </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (min-width: 728px) {
    .control-item-icon.fade-left-a {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from "../../scripts/gsap";

  document.querySelectorAll<HTMLElement>(".control-section").forEach((section) => {
    const items = gsap.utils.toArray<HTMLElement>(section.querySelectorAll(".control-item"));
    if (!items.length) return;
    const media = gsap.matchMedia();
    media.add("(min-width: 728px) and (max-width: 1279px) and (prefers-reduced-motion: no-preference)", () => {
      items.forEach((item, index) => {
        item.classList.add("fade-up-a");
        item.style.setProperty("--fade-up-delay", `${index * 0.2}s`);
      });
      if (!("IntersectionObserver" in window)) {
        items.forEach((item) => item.classList.add("active"));
        return () => items.forEach((item) => {
          item.classList.remove("fade-up-a", "active");
          item.style.removeProperty("--fade-up-delay");
        });
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("active");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.3 });
      items.forEach((item) => observer.observe(item));
      return () => {
        observer.disconnect();
        items.forEach((item) => {
          item.classList.remove("fade-up-a", "active");
          item.style.removeProperty("--fade-up-delay");
        });
      };
    });

    media.add("(min-width: 1280px) and (prefers-reduced-motion: no-preference)", () => {
      if (section.scrollHeight > window.innerHeight + 1) return;
      section.classList.add("control-scroll-controlled");
      gsap.set(items, { y: 50, autoAlpha: 0 });
      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: () => `+=${window.innerHeight * items.length * 0.6}`,
          pin: true,
          pinSpacing: true,
          scrub: true,
          refreshPriority: -2,
          invalidateOnRefresh: true,
        },
      });
      items.forEach((item, index) => {
        timeline.to(item, { y: 0, autoAlpha: 1, duration: 0.45, ease: "power2.out" }, index)
          .call(() => item.querySelectorAll(".fade-up-lines-raw").forEach((text) => text.classList.add("active")), [], index + 0.1)
          .to({}, { duration: 0.55 }, index + 0.45);
      });
      let lockedUntil = 0;
      const onWheel = (event: WheelEvent) => {
        const trigger = timeline.scrollTrigger;
        if (!trigger || event.ctrlKey || document.documentElement.classList.contains("desktop-menu-open") ||
            document.getElementById("mobile-menu")?.classList.contains("translate-x-0")) return;
        const now = performance.now();
        if (trigger.isActive && now < lockedUntil) { event.preventDefault(); return; }
        if (!trigger.isActive || Math.abs(event.deltaY) < 2) return;
        if ((event.deltaY < 0 && trigger.progress <= 0.001) ||
            (event.deltaY > 0 && trigger.progress >= 0.999)) return;
        const current = Math.round(trigger.progress * items.length);
        const next = gsap.utils.clamp(0, items.length, current + (event.deltaY > 0 ? 1 : -1));
        event.preventDefault();
        lockedUntil = now + 900;
        window.scrollTo({ top: trigger.start + (trigger.end - trigger.start) * next / items.length, behavior: "smooth" });
      };
      window.addEventListener("wheel", onWheel, { passive: false, capture: true });
      ScrollTrigger.sort();
      ScrollTrigger.refresh();
      return () => {
        window.removeEventListener("wheel", onWheel, true);
        section.classList.remove("control-scroll-controlled");
        items.forEach((item) => item.querySelectorAll(".fade-up-lines-raw").forEach((text) => text.classList.add("active")));
      };
    });
  });
</script>
