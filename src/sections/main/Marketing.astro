---
type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["marketing"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class='w-full flex justify-center items-center bg-primary text-paragraph'>
  <div class="container-full flex flex-col justify-center items-center gap-10 py-12 md:py-20">
    <div class='flex flex-col justify-center item-start md:items-center gap-6 '>
      <p class='subtitle-lg' set:html={content.tag}></p>
      <h2 set:html={content.title} class='heading-h4 text-start md:text-center'></h2>
    </div>
    <div class="marketing-cards w-full grid grid-cols-1 md:grid-cols-2 gap-6 justify-center items-center md:items-stretch">
      {
        content.pc.map((item,index)=>(
          <div class={`marketing-card w-full flex flex-col justify-center items-start gap-8 py-8 md:py-10 px-4 md:px-6 border rounded-2xl text-paragraph ${index === 0 ? "bg-transparent border-[#FF4E4E]" : "back-prices border-secondary"}`} style={`--glow-color: ${index === 0 ? "255, 78, 78" : "145, 210, 0"}`} >
            <img src={`/images/icons/${item.icon}.svg`} alt={item.title} width="50" height="50" class='w-10 h-10 fade-up-a' decoding="async" loading="lazy" />
            <h3 class={`body-lg ${index === 0 ? "" : "text-secondary"}`}>{item.title}</h3>
            <div class={`fade-up-a w-[51px] h-1 ${index === 0 ? "bg-[#FF4E4E]" : "bg-secondary"}`}></div>
            <ul class="flex flex-col justify-center items-start gap-8 md:gap-6 ">
              {
                item.list.map((i)=>(
                  <li class={` flex justify-start items-center gap-2`}>
                    <div class={`w-1.5 h-1.5 fade-up-a ${index === 0 ? "bg-[#FF4E4E]" : "bg-secondary"}`}></div>
                    <span class='body-md'>{i}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>


<style>
  .marketing-card { position: relative; isolation: isolate; }
  .marketing-card::before, .marketing-card::after {
    content: ""; position: absolute; pointer-events: none; border-radius: inherit;
    opacity: var(--glow-opacity, 0); transition: opacity 0.25s ease;
  }
  .marketing-card::before {
    inset: -1px; padding: 2px; z-index: 1;
    background: radial-gradient(circle 55px at var(--glow-x, 0px) var(--glow-y, 0px), rgba(255, 255, 255, 0.45), transparent),
      radial-gradient(circle 150px at var(--glow-x, 0px) var(--glow-y, 0px), rgba(var(--glow-color), 1), transparent);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }
  .marketing-card::after {
    inset: 0; z-index: -1;
    background: radial-gradient(circle 120px at var(--glow-x, 0px) var(--glow-y, 0px), rgba(var(--glow-color), 0.28), transparent);
  }
  @media (hover: none) { .marketing-card::before, .marketing-card::after { display: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".marketing-cards").forEach((container) => {
    const cards = container.querySelectorAll<HTMLElement>(".marketing-card");
    container.addEventListener("pointermove", (event) => {
      if (event.pointerType === "touch") return;
      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--glow-x", `${event.clientX - rect.left}px`);
        card.style.setProperty("--glow-y", `${event.clientY - rect.top}px`);
        card.style.setProperty("--glow-opacity", "1");
      });
    });
    container.addEventListener("pointerleave", () => {
      cards.forEach((card) => card.style.setProperty("--glow-opacity", "0"));
    });
  });
</script>
