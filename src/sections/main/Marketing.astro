---
type Translations = typeof import("../../i18n/en-2").default;
type Content = Translations["main"]["marketing"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class='w-full flex justify-center items-center bg-primary text-paragraph'>
  <div class="container-full flex flex-col justify-center items-center gap-10 py-12 md:py-20">
    <div class='flex flex-col justify-center item-start md:items-center gap-6 '>
      <p class='subtitle-lg' set:html={content.tag}></p>
      <h2 set:html={content.title} class='heading-h4 text-start md:text-center'></h2>
    </div>
    <div class="marketing-cards w-full grid grid-cols-1 md:grid-cols-2 gap-6 justify-center items-center md:items-stretch">
      {
        content.pc.map((item,index)=>(
          <div class={`marketing-card w-full flex flex-col justify-center items-start gap-8 py-8 md:py-10 px-4 md:px-6 border rounded-2xl text-paragraph ${index === 0 ? "bg-transparent border-[#FF4E4E]" : "back-prices border-secondary"}`}>
            <div class="marketing-card-content w-full flex flex-col justify-center items-start gap-8">
            <img src={`/images/icons/${item.icon}.svg`} alt={item.title} width="50" height="50" class='w-10 h-10 fade-up-a' decoding="async" loading="lazy" />
            <h3 class={`body-lg ${index === 0 ? "" : "text-secondary"}`}>{item.title}</h3>
            <div class={`fade-up-a w-[51px] h-1 ${index === 0 ? "bg-[#FF4E4E]" : "bg-secondary"}`}></div>
            <ul class="flex flex-col justify-center items-start gap-8 md:gap-6 ">
              {
                item.list.map((i)=>(
                  <li class={` flex justify-start items-center gap-2 fade-up-a`}>
                    <div class={`w-1.5 h-1.5  ${index === 0 ? "bg-[#FF4E4E]" : "bg-secondary"}`}></div>
                    <span class='body-md'>{i}</span>
                  </li>
                ))
              }
            </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "../../scripts/gsap";

  const tiltMedia = gsap.matchMedia();
  tiltMedia.add("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)", () => {
    const cleanup: (() => void)[] = [];
    document.querySelectorAll<HTMLElement>(".marketing-card").forEach((card) => {
      const content = card.querySelector<HTMLElement>(".marketing-card-content");
      if (!content) return;

      gsap.set(card, { transformPerspective: 650 });
      const rotateX = gsap.quickTo(card, "rotationX", { duration: 0.5, ease: "power3.out" });
      const rotateY = gsap.quickTo(card, "rotationY", { duration: 0.5, ease: "power3.out" });
      const moveX = gsap.quickTo(content, "x", { duration: 0.5, ease: "power3.out" });
      const moveY = gsap.quickTo(content, "y", { duration: 0.5, ease: "power3.out" });

      const onMove = (event: PointerEvent) => {
        if (event.pointerType === "touch") return;
        const rect = card.getBoundingClientRect();
        const x = gsap.utils.clamp(0, 1, (event.clientX - rect.left) / rect.width);
        const y = gsap.utils.clamp(0, 1, (event.clientY - rect.top) / rect.height);
        rotateX(gsap.utils.interpolate(15, -15, y));
        rotateY(gsap.utils.interpolate(-15, 15, x));
        moveX(gsap.utils.interpolate(-20, 20, x));
        moveY(gsap.utils.interpolate(-20, 20, y));
      };
      const onLeave = () => { rotateX(0); rotateY(0); moveX(0); moveY(0); };
      card.addEventListener("pointermove", onMove);
      card.addEventListener("pointerleave", onLeave);
      cleanup.push(() => {
        card.removeEventListener("pointermove", onMove);
        card.removeEventListener("pointerleave", onLeave);
      });
    });
    return () => cleanup.forEach((dispose) => dispose());
  });
</script>
