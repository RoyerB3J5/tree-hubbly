    },
  ],
};

const contentEs = {
  heading: "Mira estos videos en orden",
  title:
    'Antes de la llamada, <br /> <span class="text-secondary font-title-libre">revisa los siguientes 4 videos</span>',
  description:
    'Cada video dura menos de 2 minutos. <br class="md:hidden" />Míralos en orden.',
  videos: [
