---

<section
  class="w-full flex justify-center items-center overflow-hidden relative bg-primary"
>
  <div
    class="flex flex-col justify-center items-center gap-10 md:gap-15 py-20 md:py-24.5 container-full"
  >
    <div class="flex flex-col justify-center items-center gap-3 md:gap-5.25">
      <p
        class="text-[9px] font-light tracking-[2.34px] uppercase text-white text-center uppercase"
      >
        {content.eyebrow}
      </p>
      <h2
        class="text-[25px] md:text-[48px] leading-[100%] text-white text-center font-bold"
        set:html={content.title}
      />
      <p
        class="text-[8px] md:text-[10px] font-light text-white text-center uppercase tracking-[1px] hidden md:block"
      >
        {content.hint}
      </p>
    </div>
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-6 justify-center items-stretch w-full md:w-[80%] lg:w-[874px]"
    >
      {
        content.cards.map((card) => (
          <div class="card-back flex flex-col justify-center items-start px-8 py-6 border border-white/10 rounded-3xl h-full hover:-translate-y-1 transition-all duration-300 ease-in-out ">
            <p class="text-[14px] text-white leading-[100%] font-normal">
              {card.label}
            </p>

            {card.variant === "progress" && (
              <>
                <p class="text-[48px] font-semibold leading-[100%] pt-3 pb-8 text-white">
                  {card.value}{" "}
                  {card.valueSuffix && (
                    <span class="text-secondary  text-[18px] font-normal">
                      {card.valueSuffix}
                    </span>
                  )}
                </p>
                <div class="w-full h-2.5 bg-white/10 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-secondary rounded-full transition-all duration-300"
                    style={`width: ${card.progress};`}
                  />
                </div>
                <div class="flex flex-col justify-start items-center w-full gap-4.5 pt-8">
                  {card.rows.map((row) => (
                    <div class="w-full flex justify-between">
                      <p class="text-[13px] text-white leading-[100%] font-normal">
                        {row.label}
                      </p>
                      <p
                        class={`text-[16px] leading-[100%] font-normal ${row.highlight ? "text-secondary" : "text-white"}`}
                      >
                        {row.value}
                      </p>
                    </div>
                  ))}
                </div>
              </>
            )}

            {card.variant === "status" && (
              <>
                <div class="w-full flex flex-col justify-center items-center gap-3 pt-6">
                  {card.items.map((item) => (
                    <div class="bg-white/10 w-full p-4 rounded-xl flex justify-between items-center">
                      <p class="text-[12px] text-white leading-[100%] font-normal">
                        {item.label}
                      </p>
                      <p
                        class={`text-[12px] leading-[100%] font-normal ${item.statusColor}`}
                      >
                        {item.status}
                      </p>
                    </div>
                  ))}
                </div>
                <div class="flex flex-col justify-center items-center w-full gap-4.5 pt-8">
                  <div class="w-full flex justify-between">
                    <p class="text-[12px] text-white leading-[100%] font-normal">
                      {card.footerLabel}
                    </p>
                    <p class="text-[12px] text-white leading-[100%] font-normal">
                      {card.footerValue}
                    </p>
                  </div>
                </div>
              </>
            )}

            {card.variant === "chart" && (
              <>
                
                <img
                  src={card.chartSrc}
                  alt={card.chartAlt}
                  class="w-full h-auto pt-2"
                  decoding="async"
                  loading="lazy"
                  width="330"
                  height="54"
                />
                <div class="flex flex-col justify-center items-center w-full gap-4.5 pt-2">
                  {card.rows.map((row) => (
                    <div class="w-full flex justify-between">
                      <p class="text-[12px] text-white leading-[100%] font-normal">
                        {row.label}
                      </p>
                      <p
                        class={`text-[12px] leading-[100%] font-normal ${row.highlight ? "text-secondary" : "text-white"}`}
                      >
                        {row.value}
                      </p>
                    </div>
                  ))}
                </div>
                <p class="text-[48px] font-semibold leading-[100%]  text-white mt-2">
                  {card.value}
                </p>
              </>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
