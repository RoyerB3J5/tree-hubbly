const content = contentUs;
---

<section
  class="back-scheduling flex flex-col justify-center items-center w-full border-t border-white/10 "
>
  <div
    class="flex flex-col justify-center items-center py-10 md:py-15 gap-6 md:gap-10"
  >
    <div class="flex flex-col justify-center items-center gap-4.5 md:gap-3.75">
      <p
        class="text-[9px] font-light tracking-[2.34px] uppercase text-white text-center uppercase"
      >
        {content.tag}
      </p>
      <h2
        class="text-[25px] md:text-[48px] leading-[100%] text-white text-center font-semibold"
        set:html={content.title}
      />
    </div>
    <div
      class="hidden md:grid grid-cols-1 md:grid-cols-3 justify-center items-center gap-2.5 w-full lg:w-[900px] px-4 md:px-0"
    >
      {
        Array.from({ length: 6 }, (_, i) => (
          <div
            class="flex jusitfy-start items-end w-full h-auto rounded-[10px] border border-white/10 relative group overflow-hidden px-[14px] pb-[19px] cursor-pointer group"
            style="aspect-ratio: 293 / 400;"
          >
            {
              /*<img
              src={`/images/scheduling/comunidad-${i + 1}.webp`}
              alt={`Comunidad ${i + 1}`}
              class="w-full h-full absolute inset-0 object-cover  z-0 transition-all duration-300 ease-in-out group-hover:scale-105 grayscale group-hover:grayscale-0"
              width="300"
              height="402"
            />
            <div class="w-full h-full absolute  z-5 bg-[#000700]/65 top-0 left-0 group-hover:bg-transparent transition-all duration-300 ease-in-out" /><div class="flex flex-col justify-center items-start gap-1 z-10">
              <p class="text-white text-[8px] font-normal leading-[100%] tracking-[1.76px] uppercase">
                {content.comunidad}
              </p>
              <h3 class="text-[#F5F5F5] text-[19px] font-normal leading-[115%] tracking-[0.19px] font-georgia">
                Virality
              </h3>
            </div> */
            
            }
            
            
          </div>
        ))
      }
    </div>

    <!-- Carousel para md hacia abajo -->
    <div
      class="flex sm:flex flex-col justify-center items-center gap-4 w-full md:hidden max-w-screen"
    >
      <div
        class="carousel-comunidad-container w-full relative overflow-hidden"
        style="padding: 0;"
      >
        <style>
          .carousel-comunidad-track {
            display: flex;
            gap: 12px;
            width: 100%;
            transition: none;
            padding: 0 32px;
            box-sizing: border-box;
          }
          .carousel-comunidad-slide {
            flex: 0 0 100%;
            display: flex;
            justify-content: center;
          }
          .carousel-comunidad-container {
            overflow: hidden;
            touch-action: pan-y;
          }
          .carousel-comunidad-dot.active {
            background-color: white;
          }
        </style>
        <div class="carousel-comunidad-track">
          {
            Array.from({ length: 6 }, (_, i) => (
              <div class="carousel-comunidad-slide">
                <div
                  class="flex jusitfy-start items-end w-full h-auto rounded-[10px] border border-white/10 relative group overflow-hidden px-[14px] pb-[19px] cursor-pointer group"
                  style="aspect-ratio: 293 / 400;"
                >
                  {/* <img
                    src={`/images/scheduling/comunidad-${i + 1}.webp`}
                    alt={`Comunidad ${i + 1}`}
                    class="w-full h-full absolute inset-0 object-cover  z-0 transition-all duration-300 ease-in-out group-hover:scale-105 grayscale group-hover:grayscale-0"
                    width="300"
                    height="402"
                  />
                  <div class="w-full h-full absolute  z-5 bg-[#000700]/65 top-0 left-0 group-hover:bg-transparent transition-all duration-300 ease-in-out" />
                  <div class="flex flex-col justify-center items-start gap-1 z-10">
                    <p class="text-white text-[8px] font-normal leading-[100%] tracking-[1.76px] uppercase">
                      {content.comunidad}
                    </p>
                    <h3 class="text-[#F5F5F5] text-[19px] font-normal leading-[115%] tracking-[0.19px] font-georgia">
                      Virality
                    </h3>
                  </div>*/}
                  
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Indicadores -->
      <div
        class="carousel-comunidad-indicators flex justify-center items-center gap-2 mt-6"
      >
        {
          Array.from({ length: 6 }, (_, i) => (
            <button
              class="carousel-comunidad-dot w-2 h-2 rounded-full bg-[#F5F5F5]/25 transition-all duration-300 cursor-pointer hover:bg-white/60"
              data-slide={i}
              aria-label={`Go to slide ${i + 1}`}
            />
          ))
        }
      </div>

      <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
          const container = document.querySelector(
            ".carousel-comunidad-container",
          );
          const track = document.querySelector(".carousel-comunidad-track");
          const slides = Array.from(
            document.querySelectorAll(".carousel-comunidad-slide"),
          );
          const dots = Array.from(
            document.querySelectorAll(".carousel-comunidad-dot"),
          );

          if (!container || !track || slides.length === 0) return;

          let currentSlide = 0;
          let isAnimating = false;
          let isDragging = false;
          let startX = 0;
          let dragStartOffset = 0; // offset al inicio del drag (fijo durante el drag)
          let currentOffset = 0; // offset actual aplicado al track
          const gap = 12;

          function getSlideWidth() {
            return slides[0].getBoundingClientRect().width;
          }

          function getTargetOffset(index) {
            const sw = getSlideWidth();
            return (sw + gap) * index;
          }

          function updateDots() {
            dots.forEach((dot, i) => {
              dot.classList.toggle("active", i === currentSlide);
            });
          }

          function snapToSlide(index, duration = 400) {
            const target = getTargetOffset(index);
            isAnimating = true;

            const anim = track.animate(
              [
                { transform: `translateX(-${currentOffset}px)` },
                { transform: `translateX(-${target}px)` },
              ],
              {
                duration,
                easing: "cubic-bezier(0.25, 1, 0.5, 1)",
                fill: "forwards",
              },
            );

            anim.onfinish = () => {
              currentOffset = target;
              track.style.transform = `translateX(-${currentOffset}px)`;
              anim.cancel();
              isAnimating = false;
            };
          }

          function goToSlide(index) {
            if (isAnimating) return;
            if (index < 0 || index >= slides.length) return;
            currentSlide = index;
            updateDots();
            snapToSlide(currentSlide);
          }

          // ─── Drag / Touch ────────────────────────────────────────────

          function onDragStart(x) {
            if (isAnimating) return;
            isDragging = true;
            startX = x;
            dragStartOffset = currentOffset; // captura el offset real al inicio
          }

          function onDragMove(x) {
            if (!isDragging) return;
            const diff = startX - x;
            currentOffset = dragStartOffset + diff;
            track.style.transform = `translateX(-${currentOffset}px)`;
          }

          function onDragEnd(x) {
            if (!isDragging) return;
            isDragging = false;

            const diff = startX - x;
            const threshold = getSlideWidth() * 0.2; // 20% del slide para cambiar

            let nextSlide = currentSlide;
            if (diff > threshold) {
              nextSlide = Math.min(currentSlide + 1, slides.length - 1);
            } else if (diff < -threshold) {
              nextSlide = Math.max(currentSlide - 1, 0);
            }

            currentSlide = nextSlide;
            updateDots();
            snapToSlide(currentSlide, 350);
          }

          // Mouse
          container.addEventListener("mousedown", (e) => {
            e.preventDefault();
            onDragStart(e.clientX);
          });
          document.addEventListener("mousemove", (e) => {
            if (isDragging) onDragMove(e.clientX);
          });
          document.addEventListener("mouseup", (e) => {
            if (isDragging) onDragEnd(e.clientX);
          });

          // Touch
          container.addEventListener(
            "touchstart",
            (e) => onDragStart(e.touches[0].clientX),
            { passive: true },
          );
          document.addEventListener(
            "touchmove",
            (e) => {
              if (isDragging) onDragMove(e.touches[0].clientX);
            },
            { passive: true },
          );
          document.addEventListener("touchend", (e) => {
            if (isDragging) onDragEnd(e.changedTouches[0].clientX);
          });

          // Dots
          dots.forEach((dot, i) =>
            dot.addEventListener("click", () => goToSlide(i)),
          );

          // Init
          updateDots();
          track.style.transform = "translateX(0px)";

          window.addEventListener("resize", () => {
            if (!isDragging && !isAnimating) {
              currentOffset = getTargetOffset(currentSlide);
              track.style.transform = `translateX(-${currentOffset}px)`;
            }
          });
        });
      </script>
    </div>
  </div>
</section>
