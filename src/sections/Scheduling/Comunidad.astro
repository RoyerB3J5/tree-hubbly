---
const contentUs = {
  tag: "Our Network",
  title:
    'Strategies <span class="text-secondary">in action.</span>',
  comunidad: "Community",
};

const contentEs = {
  tag: "Nuestra Red",
  title:
    'Estrategias <span class="text-secondary font-georgia">en acción. </span>',
  comunidad: "comunidad",
