RewriteEngine On

# Keep the two published pages and their static assets available.
RewriteRule ^scheduling/(programme|questionnaire)/?$ - [L]
RewriteRule ^(_astro|images)(/|$) - [L]
RewriteRule ^(robots\.txt|sitemap\.xml|favicon\.ico|favicon\.svg)$ - [L]
RewriteRule ^\.well-known(/|$) - [L]

# Send every other page path to the questionnaire.
RewriteRule ^.*$ /scheduling/questionnaire/ [R=302,L,NE]
